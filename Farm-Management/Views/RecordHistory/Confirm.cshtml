@model Farm_Management.Models.ICultivationRecord
@{var restoring=ViewBag.Restoring as bool?==true;ViewData["Title"]=restoring?"Khôi phục hồ sơ":"Chuyển vào lưu trữ";}
<div class="page-header"><h1>@ViewData["Title"]</h1></div><form method="post" asp-action="@(restoring?"Restore":"Archive")" asp-route-id="@Model.Id" class="card"><input type="hidden" name="recordType" value="@ViewBag.RecordType"/><div class="form-section"><p>Hồ sơ @Farm_Management.Services.FarmRecordRules.RecordLabel((string)ViewBag.RecordType) #@Model.Id. Lịch sử, nội dung và tệp minh chứng vẫn được giữ.</p><p>Khôi phục chỉ được thực hiện khi các tham chiếu và quy tắc nghiệp vụ còn phù hợp.</p></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Archived" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">@(restoring?"Xác nhận khôi phục":"Chuyển vào lưu trữ")</button></div></form>

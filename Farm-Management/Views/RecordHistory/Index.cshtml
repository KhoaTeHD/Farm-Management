@model List<Farm_Management.Models.CultivationAudit>
@using System.Text.Json
@using Farm_Management.Services
@{ViewData["Title"]="Lịch sử & lưu hồ sơ";var pageNumber=(int)ViewBag.Page;var total=(int)ViewBag.Total;string Value(JsonElement? e)=>e?.ValueKind==JsonValueKind.Null||e==null?"Chưa có":e.Value.ValueKind==JsonValueKind.String?e.Value.GetString()??"Chưa có":e.Value.ToString();Dictionary<string,JsonElement> Read(string? s){try{return JsonSerializer.Deserialize<Dictionary<string,JsonElement>>(s??"{}")??new();}catch(JsonException){return new();}}}
<div class="page-header"><div><h1>Lịch sử thay đổi và lưu hồ sơ</h1><p class="page-description">Giữ nội dung trước/sau, thời điểm, tên người nhập và lý do. Tên được tự khai, chưa xác thực bằng tài khoản.</p></div><a asp-action="Archived" class="btn btn-outline-farm">Hồ sơ lưu trữ / khôi phục</a></div>
<div class="alert alert-info"><div><strong>Chính sách lưu:</strong> giữ toàn bộ hồ sơ và tệp minh chứng, không có chức năng xóa vĩnh viễn hoặc tự dọn. Tối thiểu 24 tháng kể từ thu hoạch; hiện ứng dụng giữ lâu hơn, gồm cả bản sửa và hồ sơ lưu trữ. Lịch sử bắt đầu từ khi triển khai tính năng; dữ liệu có trước chỉ có bản ghi nhận ban đầu, không thể dựng lại các sửa đổi đã xảy ra. Sao lưu cần gồm database và thư mục ảnh/phiếu.</div></div>
<p><a asp-controller="Home" asp-action="Index">← Tổng quan</a> · <a asp-controller="FarmRecords" asp-action="Index">Vật tư & kiểm nghiệm</a></p>
@foreach(var a in Model){var before=Read(a.BeforeJson);var after=Read(a.AfterJson);<section class="card mb-3"><div class="card-header"><h2 class="h6">#@a.Id · @FarmRecordRules.RecordLabel(a.RecordType) #@a.RecordId · @(a.Action=="Created"?"Tạo mới":a.Action=="Updated"?"Sửa":a.Action=="Archived"?"Chuyển vào lưu trữ":a.Action=="Restored"?"Khôi phục":"Ghi nhận ban đầu")</h2><p class="mb-0">@FarmRecordRules.Time(a.OccurredAt) (giờ Việt Nam) · Người nhập: @(a.Actor??"Chưa xác định")</p><p class="mb-0 preserve-lines">Lý do: @(a.Reason??"Chưa có ghi chú")</p></div><div class="table-responsive"><table class="table"><thead><tr><th>Thông tin</th><th>Trước</th><th>Sau</th></tr></thead><tbody>@foreach(var key in before.Keys.Union(after.Keys)){if(new[]{"Id","SourceHash","RecordCode","CreatedAt","UpdatedAt"}.Contains(key)){continue;}JsonElement? b=before.TryGetValue(key,out var bv)?bv:null;JsonElement? n=after.TryGetValue(key,out var nv)?nv:null;if(Value(b)==Value(n)){continue;}<tr><th>@HistoryDisplay.Label(key)</th>@foreach(var val in new[]{b,n}){var text=Value(val);<td class="preserve-lines">@if(key=="SnapshotJson"){<span>Bản hồ sơ truy xuất được lưu riêng; xem các nút bên dưới.</span>}else if(CropSeasonRules.PhotoIsLocal(text)||FarmRecordRules.EvidenceLocal(text)){<a href="@text" target="_blank" rel="noopener">Mở tệp minh chứng được giữ</a>}else{@HistoryDisplay.Value(key,val)}</td>}</tr>}</tbody></table></div>@if(a.RecordType=="HarvestTrace"){<div class="crop-actions p-3">@if(a.BeforeJson!=null){<a asp-action="TraceVersion" asp-route-id="@a.Id" asp-route-side="Before">Xem bản truy xuất trước</a>}@if(a.AfterJson!=null){<a asp-action="TraceVersion" asp-route-id="@a.Id" asp-route-side="After">Xem bản truy xuất sau</a>}</div>}</section>}
@if(!Model.Any()){<div class="card p-4">Chưa có lịch sử phù hợp bộ lọc.</div>}
<div class="crop-actions mt-3">@if(pageNumber>1){<a asp-action="Index" asp-route-recordType="@ViewBag.RecordType" asp-route-recordId="@ViewBag.RecordId" asp-route-plantId="@ViewBag.PlantId" asp-route-page="@(pageNumber-1)">← Trang trước</a>}<span>Trang @pageNumber · @total phiên bản</span>@if(pageNumber*30<total){<a asp-action="Index" asp-route-recordType="@ViewBag.RecordType" asp-route-recordId="@ViewBag.RecordId" asp-route-plantId="@ViewBag.PlantId" asp-route-page="@(pageNumber+1)">Trang sau →</a>}</div>

@model List<(string Type,int Id,string Name,DateTime? Date)>
@{ViewData["Title"]="Hồ sơ lưu trữ";}
<div class="page-header"><div><h1>Hồ sơ đã chuyển vào lưu trữ</h1><p class="page-description">Hồ sơ vẫn được giữ trong database, ảnh/phiếu không bị dọn. Khôi phục sẽ ghi thêm một phiên bản lịch sử.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Lịch sử thay đổi</a></div><section class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Hồ sơ</th><th>Thời điểm</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Name<small class="d-block">@Farm_Management.Services.FarmRecordRules.RecordLabel(r.Type) #@r.Id</small></td><td>@Farm_Management.Services.FarmRecordRules.Time(r.Date)</td><td><div class="crop-actions"><a asp-action="Restore" asp-route-recordType="@r.Type" asp-route-id="@r.Id">Khôi phục</a><a asp-action="Index" asp-route-recordType="@r.Type" asp-route-recordId="@r.Id">Xem lịch sử</a></div></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="p-4">Chưa có hồ sơ lưu trữ.</p>}</section>

@model Farm_Management.Models.ViewModels.InspectionForm
@using Farm_Management.Services
@{ViewData["Title"]="Phiếu kiểm nghiệm";}
<div class="page-header"><div><h1>Ghi phiếu kiểm nghiệm</h1><p class="page-description">Chép từ phiếu thật: đối tượng lấy mẫu, ngày, đơn vị, chỉ tiêu, kết quả và tài liệu đối chiếu. Không tự đoán ngưỡng.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Vật tư & kiểm nghiệm</a></div>
<form method="post" enctype="multipart/form-data" asp-action="@(Model.Id==0?"CreateInspection":"EditInspection")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><label asp-for="TargetType" class="form-label"></label><select asp-for="TargetType" class="form-select"><option value="">Chọn loại hồ sơ</option>@foreach(var t in FarmRecordRules.TargetTypes){<option value="@t.Key">@t.Value</option>}</select><label for="TargetId" class="form-label mt-3">Hồ sơ được lấy mẫu</label><select name="TargetId" id="TargetId" class="form-select" required><option value="">Chọn hồ sơ</option>@foreach(var l in (List<Farm_Management.Models.InputLot>)ViewBag.Inputs){<option value="@l.Id" data-target="InputLot" selected="@(Model.TargetType=="InputLot"&&Model.TargetId==l.Id)">Vật tư: @l.Code · @l.ProductName</option>}@foreach(var r in (List<Farm_Management.Models.FieldResource>)ViewBag.Resources){<option value="@r.Id" data-target="FieldResource" selected="@(Model.TargetType=="FieldResource"&&Model.TargetId==r.Id)">Đất/nước: @r.Name</option>}@foreach(var h in (List<Farm_Management.Models.HarvestTrace>)ViewBag.Harvests){<option value="@h.Id" data-target="HarvestTrace" selected="@(Model.TargetType=="HarvestTrace"&&Model.TargetId==h.Id)">Thu hoạch: @h.Code</option>}</select><div class="row g-3 mt-1">@foreach(var field in new[]{"ReportNumber","Laboratory","Indicator"}){<div class="col-md-6">@Html.Label(field,null,new{@class="form-label"})@Html.TextBox(field,null,new{@class="form-control"})</div>}<div class="col-md-6"><label asp-for="SampleDate" class="form-label"></label><input asp-for="SampleDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-6"><label asp-for="ReportDate" class="form-label"></label><input asp-for="ReportDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div></div><label asp-for="Result" class="form-label mt-3"></label><textarea asp-for="Result" rows="3" class="form-control" placeholder="Chép giá trị, đơn vị và ghi chú từ phiếu; một phiếu có nhiều nhóm chỉ tiêu có thể nhập thành nhiều dòng hồ sơ."></textarea><label asp-for="LimitReference" class="form-label mt-3"></label><textarea asp-for="LimitReference" rows="2" class="form-control" placeholder="Tên tài liệu/phiên bản và ngưỡng hoặc phần kết luận trên phiếu."></textarea><label asp-for="Conclusion" class="form-label mt-3"></label><select asp-for="Conclusion" class="form-select">@foreach(var c in FarmRecordRules.Conclusions){<option value="@c.Key">@c.Value</option>}</select><p class="form-text">Kết luận do người phụ trách ghi theo phiếu, không được phần mềm tự xác nhận đạt VietGAP. Kết quả không đạt/chưa rõ sẽ tạm giữ vật tư hoặc nguồn; sau khắc phục thêm phiếu mới cùng chỉ tiêu để giữ lịch sử.</p><label asp-for="Evidence" class="form-label"></label><input asp-for="Evidence" type="file" accept="application/pdf,image/jpeg,image/png" class="form-control"/><p class="form-text">PDF, JPG hoặc PNG tối đa 10 MB. Tải bản mới vẫn giữ tệp cũ trong lịch sử.</p>@if(FarmRecordRules.EvidenceLocal(Model.ExistingEvidence)){<a href="@Model.ExistingEvidence" target="_blank" rel="noopener">Xem phiếu đang lưu</a>}</div><partial name="_RecordChange"/><div class="form-actions"><button type="submit" class="btn btn-farm">Lưu phiếu kiểm nghiệm</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>const type=document.getElementById('TargetType'),target=document.getElementById('TargetId');function chooseTarget(){[...target.options].forEach(o=>{o.disabled=!!o.value&&o.dataset.target!==type.value;o.hidden=o.disabled;});if(target.selectedOptions[0]?.disabled)target.value='';}type.addEventListener('change',chooseTarget);chooseTarget();</script>}

@model Farm_Management.Models.ViewModels.ResourceForm
@using Farm_Management.Services
@{ViewData["Title"]="Hồ sơ đất / nguồn nước";}
<div class="page-header"><div><h1>Đất / nguồn nước của vùng trồng</h1><p class="page-description">Ghi rõ vị trí, nguy cơ ô nhiễm và cách xử lý để các lần tưới truy được đúng nguồn.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Vật tư & kiểm nghiệm</a></div>
<form method="post" asp-action="@(Model.Id==0?"CreateResource":"EditResource")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="AreaId" class="form-label"></label><select asp-for="AreaId" class="form-select"><option value="">Chọn vùng trồng</option>@foreach(var a in (List<Farm_Management.Models.Area>)ViewBag.Areas){<option value="@a.Id">@(a.Name??"Vùng chưa có tên")</option>}</select></div><div class="col-md-6"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" class="form-select"><option value="">Chọn loại</option>@foreach(var k in FarmRecordRules.ResourceKinds){<option value="@k.Key">@k.Value</option>}</select></div></div><label asp-for="Name" class="form-label mt-3"></label><input asp-for="Name" class="form-control" placeholder="Ví dụ: Giếng phía đông ruộng"/><label asp-for="Location" class="form-label mt-3"></label><input asp-for="Location" class="form-control" placeholder="Vị trí dễ nhận diện, gần nguồn thải nào?"/><label asp-for="RiskAssessment" class="form-label mt-3"></label><textarea asp-for="RiskAssessment" rows="3" class="form-control" placeholder="Mô tả điều đã kiểm tra: dòng chảy, nguồn thải, tình trạng đất… Chưa kiểm tra thì ghi rõ và giữ Tạm giữ."></textarea><label asp-for="Treatment" class="form-label mt-3"></label><textarea asp-for="Treatment" rows="3" class="form-control"></textarea><label asp-for="Status" class="form-label mt-3"></label><select asp-for="Status" class="form-select">@foreach(var s in FarmRecordRules.Statuses){<option value="@s.Key">@s.Value</option>}</select><p class="form-text">Chưa có phiếu kiểm nghiệm không đồng nghĩa đã kiểm nghiệm đạt. Thêm phiếu từ danh sách sau khi có kết quả thực tế.</p></div><partial name="_RecordChange"/><div class="form-actions"><button type="submit" class="btn btn-farm">Lưu hồ sơ đất / nước</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

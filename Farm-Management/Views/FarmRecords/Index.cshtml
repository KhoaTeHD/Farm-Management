@model List<Farm_Management.Models.InputLot>
@using Farm_Management.Models
@using Farm_Management.Services
@{ViewData["Title"]="Vật tư & kiểm nghiệm";var resources=(List<FieldResource>)ViewBag.Resources;var reports=(List<InspectionReport>)ViewBag.Reports;var areas=(Dictionary<int,Area>)ViewBag.Areas;var usage=(List<CropJournalEntry>)ViewBag.Usage;}
<div class="page-header"><div><p class="eyebrow">NGUỒN GỐC & KIỂM SOÁT ĐẦU VÀO</p><h1>Vật tư, đất / nước và kiểm nghiệm</h1><p class="page-description">Nhập lô hàng và nguồn của từng vùng trước, sau đó chọn đúng hồ sơ khi ghi chăm sóc.</p></div><a asp-controller="RecordHistory" asp-action="Archived" class="btn btn-outline-secondary">Hồ sơ lưu trữ</a></div>
<div class="crop-actions mb-4"><a asp-action="CreateInput" class="btn btn-farm">+ Nhập lô vật tư</a><a asp-action="CreateResource" class="btn btn-outline-farm">+ Hồ sơ đất / nguồn nước</a><a asp-action="CreateInspection" class="btn btn-outline-farm">+ Phiếu kiểm nghiệm</a><a asp-controller="RecordHistory" asp-action="Index">Lịch sử thay đổi →</a></div>
<details class="card crop-help mb-4" open><summary>Cách dùng cho nông dân</summary><div><ol><li>Nhận phân, thuốc hoặc giống: tạo lô vật tư theo bao bì và nơi mua. Chưa kiểm tra thì giữ “Tạm giữ”.</li><li>Ghi đất/nguồn nước cho đúng vùng, mô tả nguy cơ và cách xử lý.</li><li>Có kết quả xét nghiệm: bấm “Thêm kiểm nghiệm” ở đúng hồ sơ, chép chỉ tiêu và kết luận, đính kèm phiếu.</li><li>Chỉ cho sử dụng khi người phụ trách đã kiểm tra. Khi ghi tưới/bón/phun, chọn đúng nguồn/lô.</li><li>Kết quả không đạt: giữ nguyên phiếu, ghi biện pháp khắc phục và thêm kết quả mới cùng tên chỉ tiêu để đối chiếu.</li></ol><p>Lượng đã ghi dùng chỉ tổng hợp nhật ký bón/phun; chưa bao gồm gieo giống, mất mát hoặc các lần dùng chưa nhập. Đây chưa phải báo cáo cân bằng khối lượng đầy đủ.</p></div></details>
<section class="card mb-4" data-list><div class="card-header"><h2>Lô vật tư</h2></div><div class="list-toolbar"><input type="search" data-list-search class="form-control" aria-label="Tìm vật tư" placeholder="Mã, tên sản phẩm, nơi mua…"/></div><div class="table-responsive"><table class="table"><thead><tr><th>Lô / nguồn gốc</th><th>Nhận / hạn dùng</th><th>Lượng nhận / đã ghi dùng</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var l in Model){var amounts=usage.Where(e=>e.InputLotId==l.Id).Select(e=>FarmRecordRules.ConvertAmount(e.Amount,e.Unit,l.Unit)).ToList();<tr data-list-row data-search="@l.Code @l.ProductName @l.Supplier"><td><strong>@(l.Code??"Thiếu mã") · @l.ProductName</strong><small class="d-block">Lô NSX: @(l.ManufacturerBatch??"Chưa có") · @(l.Supplier??"Chưa rõ nơi mua")</small></td><td>@(l.ReceivedDate?.ToString("dd/MM/yyyy")??"Chưa có ngày")<small class="d-block">Hạn @(l.ExpiryDate?.ToString("dd/MM/yyyy")??"chưa ghi")</small>@if(l.ExpiryDate<DateTime.Today){<span class="badge bg-danger">Đã hết hạn theo ngày hiện tại</span>}</td><td>@(l.Quantity?.ToString("0.##")??"Chưa rõ") @l.Unit<small class="d-block">Đã ghi dùng: @(amounts.Any(a=>a==null)?"Cần kiểm tra":amounts.Sum().ToString()) @l.Unit</small></td><td>@FarmRecordRules.Statuses.GetValueOrDefault(l.Status??"","Chưa rõ")<small class="d-block">@reports.Count(r=>r.TargetType=="InputLot"&&r.TargetId==l.Id) phiếu kiểm nghiệm</small></td><td><div class="crop-actions"><a asp-action="EditInput" asp-route-id="@l.Id">Mở / sửa</a><a asp-action="CreateInspection" asp-route-targetType="InputLot" asp-route-targetId="@l.Id">Thêm kiểm nghiệm</a><a asp-controller="RecordHistory" asp-action="Index" asp-route-recordType="InputLot" asp-route-recordId="@l.Id">Lịch sử</a><a asp-controller="RecordHistory" asp-action="Archive" asp-route-recordType="InputLot" asp-route-id="@l.Id">Lưu trữ</a></div></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="p-4">Chưa có lô vật tư. Bấm “Nhập lô vật tư” để bắt đầu.</p>}</section>
<section class="card mb-4"><div class="card-header"><h2>Đất / nguồn nước</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Nguồn và vùng</th><th>Nguy cơ / xử lý</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var r in resources){<tr><td><strong>@r.Name</strong><small class="d-block">@(r.AreaId.HasValue?areas.GetValueOrDefault(r.AreaId.Value)?.Name:"Thiếu vùng") · @FarmRecordRules.ResourceKinds.GetValueOrDefault(r.Kind??"","Chưa rõ loại")</small><small>@r.Location</small></td><td><p class="preserve-lines">@r.RiskAssessment</p><p class="preserve-lines">@r.Treatment</p></td><td>@FarmRecordRules.Statuses.GetValueOrDefault(r.Status??"","Chưa rõ")</td><td><div class="crop-actions"><a asp-action="EditResource" asp-route-id="@r.Id">Mở / sửa</a><a asp-action="CreateInspection" asp-route-targetType="FieldResource" asp-route-targetId="@r.Id">Thêm kiểm nghiệm</a><a asp-controller="RecordHistory" asp-action="Index" asp-route-recordType="FieldResource" asp-route-recordId="@r.Id">Lịch sử</a><a asp-controller="RecordHistory" asp-action="Archive" asp-route-recordType="FieldResource" asp-route-id="@r.Id">Lưu trữ</a></div></td></tr>}</tbody></table></div>@if(!resources.Any()){<p class="p-4">Chưa có hồ sơ đất/nguồn nước.</p>}</section>
<section class="card"><div class="card-header"><h2>Phiếu kiểm nghiệm đã ghi</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Phiếu / đối tượng</th><th>Ngày / đơn vị</th><th>Chỉ tiêu, kết quả, ngưỡng</th><th>Kết luận</th><th></th></tr></thead><tbody>@foreach(var r in reports){<tr><td>@(r.ReportNumber??"Thiếu số phiếu")<small class="d-block">@FarmRecordRules.TargetTypes.GetValueOrDefault(r.TargetType??"","Chưa rõ đối tượng") #@r.TargetId</small></td><td>Lấy mẫu @(r.SampleDate?.ToString("dd/MM/yyyy")??"chưa có")<small class="d-block">Trả @(r.ReportDate?.ToString("dd/MM/yyyy")??"chưa có") · @r.Laboratory</small></td><td><strong>@r.Indicator</strong><p class="preserve-lines">@r.Result</p><small class="preserve-lines">@r.LimitReference</small></td><td><span class="badge @(r.Conclusion=="Pass"?"bg-success":r.Conclusion=="Fail"?"bg-danger":"bg-warning")">@FarmRecordRules.Conclusions.GetValueOrDefault(r.Conclusion??"","Chưa rõ")</span></td><td><div class="crop-actions"><a asp-action="EditInspection" asp-route-id="@r.Id">Mở / sửa</a><a asp-controller="RecordHistory" asp-action="Index" asp-route-recordType="InspectionReport" asp-route-recordId="@r.Id">Lịch sử</a>@if(FarmRecordRules.EvidenceLocal(r.EvidencePath)){<a href="@r.EvidencePath" target="_blank" rel="noopener">Xem tệp phiếu</a>}</div></td></tr>}</tbody></table></div>@if(!reports.Any()){<p class="p-4">Chưa có phiếu; không coi việc chưa nhập là đã kiểm nghiệm đạt.</p>}</section>

@model Farm_Management.Models.ViewModels.InputLotForm
@using Farm_Management.Services
@{ViewData["Title"]="Hồ sơ lô vật tư";}
<div class="page-header"><div><h1>Hồ sơ lô vật tư đầu vào</h1><p class="page-description">Mỗi lần nhận hàng tạo một lô riêng, chép đúng bao bì và chứng từ. Chỉ chọn cho sử dụng sau khi người phụ trách kiểm tra.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Vật tư & kiểm nghiệm</a></div>
<form method="post" asp-action="@(Model.Id==0?"CreateInput":"EditInput")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><div class="row g-3">@foreach(var field in new[]{"Code","ProductName","ManufacturerBatch","Supplier","InvoiceNumber","RegistrationNumber"}){<div class="col-md-6">@Html.Label(field,null,new{@class="form-label"})@Html.TextBox(field,null,new{@class="form-control"})</div>}<div class="col-md-6"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" class="form-select"><option value="">Chọn nhóm</option>@foreach(var k in FarmRecordRules.InputKinds){<option value="@k.Key">@k.Value</option>}</select></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach(var s in FarmRecordRules.Statuses){<option value="@s.Key">@s.Value</option>}</select></div><div class="col-md-6"><label asp-for="ReceivedDate" class="form-label"></label><input asp-for="ReceivedDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-6"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" type="number" min="0.01" max="1000000000" step="0.01" class="form-control"/></div><div class="col-md-6"><label asp-for="Unit" class="form-label"></label><select asp-for="Unit" class="form-select"><option value="">Chọn đơn vị</option>@foreach(var u in FarmRecordRules.Units){<option value="@u">@(u=="count"?"cái / cây":u)</option>}</select></div></div><label asp-for="Notes" class="form-label mt-3"></label><textarea asp-for="Notes" rows="3" class="form-control" placeholder="Bao bì nguyên vẹn? Hạn dùng? Giấy tờ nguồn gốc? Ai đã kiểm tra?"></textarea><p class="form-text">Thông tin đăng ký và trạng thái do người phụ trách đối chiếu thực tế; phần mềm không xác nhận sản phẩm được pháp luật cho phép chỉ từ mã đã nhập.</p></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu lô vật tư</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

@model Farm_Management.Models.ViewModels.CropSeasonViewModel
@using Farm_Management.Services
@{ ViewData["Title"] = "Sổ mùa vụ"; var p = Model.Plant; var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-header"><div><p class="eyebrow">TỪ CÂY CON ĐẾN THU HOẠCH</p><h1>@(p.SeasonName ?? p.BatchCode ?? "Mùa vụ chưa có tên")</h1><p class="page-description">@p.BatchCode · @(p.PlantType?.Name ?? "Thiếu loại cây") · @(p.Seed?.Name ?? "Thiếu giống") · @(p.Area?.Name ?? "Thiếu vùng")</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Các mùa vụ</a></div>
<div class="crop-actions mb-4"><a asp-controller="HarvestTrace" asp-action="Index" asp-route-plantId="@p.Id" class="btn btn-outline-farm">Mã lô thu hoạch</a><a asp-controller="RecordHistory" asp-action="Index" asp-route-plantId="@p.Id">Lịch sử mùa vụ</a><a class="btn btn-farm" asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@p.Id">+ Ghi việc đã làm</a><a class="btn btn-outline-farm" asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@p.Id" asp-route-kind="Observation">Ghi tình trạng cây</a><a class="btn btn-outline-secondary" asp-action="Evaluation" asp-route-id="@p.Id">Ghi kinh nghiệm mùa này</a><a class="btn btn-outline-secondary" asp-action="Compare" asp-route-leftId="@p.Id">So với mùa khác</a></div>
@if(p.Area==null || p.PlantType==null || p.Seed==null || p.PlantingDate==null || p.Seed.PlantTypeId!=p.PlantTypeId){<div class="alert alert-warning">Hồ sơ còn thiếu hoặc chưa khớp thông tin. <a asp-action="Edit" asp-route-id="@p.Id">Bổ sung hồ sơ mùa vụ</a> trước khi ghi nhật ký.</div>}
@if(Model.IncompleteEntries>0){<div class="alert alert-warning">Có @Model.IncompleteEntries ghi chép cần bổ sung ngày, người ghi hoặc công việc. Mở Sửa ở dòng tương ứng; dữ liệu thiếu không được xem là kết quả hợp lệ.</div>}
@if(Model.IncompleteSteps>0){<div class="alert alert-warning">Có @Model.IncompleteSteps việc dự kiến thiếu ngày hoặc nội dung hợp lệ; cần bổ sung trước khi đối chiếu tiến độ.</div>}
<section class="stat-grid"><div class="stat-card"><div class="stat-top">Ngày xuống giống</div><strong class="crop-stat">@(p.PlantingDate?.ToString("dd/MM/yyyy")??"Chưa ghi")</strong><small>@CropRules.Label(p.Status) · @(p.Quantity?.ToString("N0",vi)??"Chưa rõ số") cây</small></div><div class="stat-card"><div class="stat-top">Việc theo kế hoạch đã ghi nhận</div><strong>@Model.DoneSteps<span>/ @Model.Steps.Count việc</span></strong><small>@Model.DueSteps việc đến ngày nhưng chưa có nhật ký</small></div><div class="stat-card"><div class="stat-top">Tỷ lệ sống lần thăm gần nhất</div><strong>@(Model.LatestObservation?.SurvivalPercent?.ToString("0.##",vi)??"Chưa đo")<span>@(Model.LatestObservation?.SurvivalPercent.HasValue==true?"%":"")</span></strong><small>@(Model.LatestObservation?.Date?.ToString("dd/MM/yyyy")??"Chưa có lần thăm vườn")</small></div><div class="stat-card"><div class="stat-top">Sản lượng đã ghi nhận</div><strong>@(Model.HarvestKg?.ToString("N2",vi)??(Model.HarvestIncomplete?"Cần kiểm tra":"Chưa ghi"))<span>kg</span></strong><small>@(Model.HarvestIncomplete?"Có đợt thiếu ngày hoặc lượng thu hoạch":"Cộng các đợt đã ghi; chưa quy đổi theo diện tích")</small></div></section>
<partial name="_MaterialUsage" model="new Farm_Management.Models.ViewModels.MaterialUsageTableViewModel { Rows = Model.MaterialUses, CanEdit = true }"/>
<details class="card crop-help mb-4"><summary>Chưa biết ghi gì? Bấm xem ví dụ</summary><div><p><strong>Sau mỗi lần chăm cây:</strong> bấm “Ghi việc đã làm”, chọn đúng việc, ghi ngày, người làm, lượng đã dùng và cây có biểu hiện gì.</p><p><strong>Khi thăm vườn:</strong> bấm “Ghi tình trạng cây”. Ví dụ: “Cây có 4–5 lá, cao khoảng 12 cm; 95% còn sống; góc vườn bị vàng lá”. Đo vài cây đại diện theo cùng cách mỗi lần; chưa biết tỷ lệ thì để trống.</p><p><strong>Cuối vụ:</strong> ghi từng đợt thu hoạch bằng kg, mô tả chất lượng, rồi bấm “Ghi kinh nghiệm mùa này”. Ví dụ: “Chỗ trũng cây chết nhiều; vụ sau làm rãnh trước khi trồng”.</p></div></details>
<section class="card mb-4"><div class="card-header d-flex flex-wrap justify-content-between gap-2"><h2 class="mb-0">1. Việc dự định làm</h2><a asp-controller="CarePlans" asp-action="Create" asp-route-plantId="@p.Id" class="btn btn-sm btn-outline-farm">+ Thêm việc dự kiến</a></div><div class="card-body"><p class="text-muted">Đây là kế hoạch của bạn. Hoàn thành được ghi nhận bằng nhật ký thực tế.</p>@if(!Model.Steps.Any()){<p>Chưa có kế hoạch. Thêm việc như “Ngày 7: kiểm tra tỷ lệ sống”, “Ngày 14: kiểm tra lá”.</p>}else{<div class="crop-plan-list">@foreach(var s in Model.Steps){var due=CropSeasonRules.PlanDate(p.PlantingDate,s.PlannedDay);var done=Model.StepDone(s);var actual=Model.FirstActual(s);<article class="crop-plan"><div><span class="badge @(done?"bg-success":due<=DateTime.Today?"bg-warning":"bg-secondary")">@(done?"Đã có nhật ký":due<=DateTime.Today?"Đến ngày, chưa ghi":"Dự kiến")</span><h3 class="h6 mt-2">@(s.Title??"Việc chưa có tên")</h3><p class="small">Ngày thứ @(s.PlannedDay?.ToString()??"?") · @(due?.ToString("dd/MM/yyyy")??"Chưa xác định ngày") · @CropSeasonRules.KindLabel(s.Kind)</p><p class="preserve-lines">@s.Instructions</p>@if(actual?.Date!=null){<p class="small text-success">Đã ghi thực tế: @actual.Date.Value.ToString("dd/MM/yyyy") @if(due.HasValue){var offset=(actual.Date.Value.Date-due.Value.Date).Days;<span>· @(offset==0?"đúng ngày dự kiến":offset>0?$"sau dự kiến {offset} ngày":$"trước dự kiến {-offset} ngày")</span>}</p>}</div><div class="crop-actions"><a class="btn btn-sm btn-outline-farm" asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@p.Id" asp-route-stepId="@s.Id">Ghi việc đã làm</a><a asp-controller="CarePlans" asp-action="Edit" asp-route-id="@s.Id">Sửa kế hoạch</a><a asp-controller="CarePlans" asp-action="Delete" asp-route-id="@s.Id">Bỏ việc</a></div></article>}</div>}</div></section>
<section class="card mb-4" id="growth"><div class="card-header"><h2 class="mb-0">2. Cây lớn lên qua từng lần thăm vườn</h2></div>@if(!Model.Entries.Any(e=>e.Kind=="Observation")){<div class="card-body"><p>Chưa có lần quan sát. Nên ghi định kỳ và sau khi thay đổi cách chăm sóc.</p><a class="btn btn-outline-farm" asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@p.Id" asp-route-kind="Observation">+ Ghi lần thăm vườn</a></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Ngày</th><th>Giai đoạn</th><th>Tình trạng</th><th>Cao (cm)</th><th>Sống (%)</th><th>Bị ảnh hưởng (%)</th><th></th></tr></thead><tbody>@foreach(var e in Model.Entries.Where(e=>e.Kind=="Observation").OrderBy(e=>e.Date)){<tr><td>@(e.Date?.ToString("dd/MM/yyyy")??"Thiếu ngày")</td><td>@(e.GrowthStage!=null?CropSeasonRules.Stages.GetValueOrDefault(e.GrowthStage,"Chưa rõ"):"Chưa rõ")</td><td>@(e.Condition!=null?CropSeasonRules.Conditions.GetValueOrDefault(e.Condition,"Chưa rõ"):"Chưa rõ")</td><td>@(e.HeightCm?.ToString("0.##",vi)??"Chưa đo")</td><td>@(e.SurvivalPercent?.ToString("0.##",vi)??"Chưa đo")</td><td>@(e.AffectedPercent?.ToString("0.##",vi)??"Chưa đo")</td><td><a asp-controller="CropJournal" asp-action="Edit" asp-route-id="@e.Id">Xem / sửa</a></td></tr>}</tbody></table></div>}</section>
<section class="card mb-4" data-list data-page-size="12"><div class="card-header"><h2 class="mb-0">3. Sổ chăm sóc theo thời gian</h2></div><div class="list-toolbar"><div class="search-field"><input type="search" class="form-control" data-list-search placeholder="Tìm việc, ghi chú…" aria-label="Tìm trong sổ chăm sóc" /></div><select class="form-select list-filter" data-list-status aria-label="Lọc công việc"><option value="">Tất cả công việc</option>@foreach(var k in CropSeasonRules.Kinds){<option value="@k.Key">@k.Value</option>}</select></div><div class="crop-timeline">@if(!Model.Timeline.Any()){<div class="empty-state compact"><h3>Sổ chăm sóc đang trống</h3><p>Ghi lần thăm vườn đầu tiên để lưu lại cây lúc còn nhỏ.</p></div>}@foreach(var t in Model.Timeline){var e=t.EntryId.HasValue?Model.Entries.First(x=>x.Id==t.EntryId):null;<article class="crop-event" data-list-row data-status="@t.Kind" data-search="@t.Title @t.Description @e?.Material @e?.Recorder"><header><span class="date-pill">@(t.Date?.ToString("dd/MM/yyyy")??"Chưa có ngày")</span><h3>@t.Title</h3></header><p class="preserve-lines">@t.Description</p>@if(e!=null){<div class="crop-event-facts">@if(e.Amount.HasValue){<span><strong>Lượng:</strong> @e.Amount.Value.ToString("N2",vi) @e.Unit</span>}@if(e.Material!=null){<span><strong>Sản phẩm:</strong> @e.Material</span>}@if(e.WithdrawalDays.HasValue){<span><strong>Cách ly:</strong> @e.WithdrawalDays ngày</span>}@if(e.Quality!=null){<span><strong>Chất lượng:</strong> @e.Quality</span>}@if(e.Method!=null){<span><strong>Cách làm:</strong> @e.Method</span>}@if(e.Weather!=null){<span><strong>Thời tiết:</strong> @e.Weather</span>}<span><strong>Người ghi:</strong> @(e.Recorder??"Chưa có")</span></div>@if(CropSeasonRules.PhotoIsLocal(e.PhotoPath)){<a href="@e.PhotoPath" target="_blank" rel="noopener"><img src="@e.PhotoPath" class="crop-photo" alt="Ảnh tại lô @p.BatchCode" loading="lazy" /></a>}<div class="crop-actions mt-3"><a asp-controller="CropJournal" asp-action="Edit" asp-route-id="@e.Id">Sửa ghi chép</a><a asp-controller="CropJournal" asp-action="Delete" asp-route-id="@e.Id">Chuyển vào lưu trữ</a><a asp-controller="RecordHistory" asp-action="Index" asp-route-recordType="CropJournalEntry" asp-route-recordId="@e.Id">Lịch sử ghi chép</a></div>}else{<small class="text-muted">Nhật ký đã có từ sổ cũ, được giữ nguyên.</small>}</article>}</div><div class="filter-empty" data-list-empty hidden>Không thấy ghi chép phù hợp.</div>@if(Model.Timeline.Any()){<div class="list-footer"><span data-list-count></span><div class="list-pagination"><button class="btn btn-sm btn-outline-secondary" type="button" data-list-prev>← Trước</button><span data-list-page></span><button class="btn btn-sm btn-outline-secondary" type="button" data-list-next>Sau →</button></div></div>}</section>
<section class="card mb-4"><div class="card-header"><h2 class="mb-0">4. Nhìn lại vụ này, chuẩn bị vụ sau</h2></div><div class="card-body"><h3 class="h6">Quy trình đang theo</h3><p class="preserve-lines">@(p.CareProtocol??"Chưa mô tả quy trình. Ghi cách chăm sóc muốn thử để cuối vụ đối chiếu.")</p><h3 class="h6">Kết quả và kinh nghiệm</h3><p class="preserve-lines">@(p.SeasonReview??"Chưa ghi nhận xét. Có thể ghi ngay trong vụ và cập nhật khi thu hoạch xong.")</p><h3 class="h6">Điều chỉnh mùa sau</h3><p class="preserve-lines">@(p.NextSeasonChanges??"Chưa ghi điều chỉnh.")</p><div class="crop-actions"><a class="btn btn-outline-farm" asp-action="Evaluation" asp-route-id="@p.Id">Ghi / sửa kinh nghiệm</a><a asp-action="Compare" asp-route-leftId="@p.Id">Đối chiếu hai mùa vụ →</a></div></div></section>
<details class="card crop-help"><summary>Thông tin lô, dự kiến thu hoạch và mốc cách ly</summary><div><p><strong>Thu hoạch dự kiến:</strong> @(p.ExpectedHarvestDate?.ToString("dd/MM/yyyy")??"Chưa có") · <strong>Mốc cách ly đã ghi:</strong> @(Model.SafeDate?.ToString("dd/MM/yyyy")??"Chưa có mốc")</p>@if(Model.SafetyIncomplete){<p class="text-danger">Nhật ký thuốc thiếu/mâu thuẫn dữ liệu; cần bổ sung trước khi ghi thu hoạch.</p>}<p>Ngày dự kiến và mốc trong sổ không thay thế việc đọc nhãn, kiểm tra thực tế và hướng dẫn của người có chuyên môn.</p><div class="crop-actions"><a asp-action="Edit" asp-route-id="@p.Id">Sửa thông tin lô / trạng thái</a><a asp-action="Delete" asp-route-id="@p.Id">Xóa lô chưa có dữ liệu</a></div></div></details>

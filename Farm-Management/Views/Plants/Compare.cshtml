@model Farm_Management.Models.ViewModels.CropComparisonViewModel
@using Farm_Management.Services
@{ViewData["Title"]="So sánh mùa vụ";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<div class="page-header"><div><p class="eyebrow">RÚT KINH NGHIỆM</p><h1>Đối chiếu hai mùa vụ</h1><p class="page-description">Xem cách chăm sóc và kết quả cạnh nhau để chọn điều cần thử thay đổi.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Các mùa vụ</a></div>
<form method="get" asp-action="Compare" class="card p-4 mb-4"><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-5"><label asp-for="LeftId" class="form-label">Mùa vụ thứ nhất</label><select asp-for="LeftId" class="form-select"><option value="">Chọn mùa vụ</option>@foreach(var p in Model.Choices){<option value="@p.Id">@(p.SeasonName??p.BatchCode??"Mùa vụ thiếu tên") · @p.BatchCode</option>}</select></div><div class="col-md-5"><label asp-for="RightId" class="form-label">Mùa vụ thứ hai</label><select asp-for="RightId" class="form-select"><option value="">Chọn mùa vụ</option>@foreach(var p in Model.Choices){<option value="@p.Id">@(p.SeasonName??p.BatchCode??"Mùa vụ thiếu tên") · @p.BatchCode</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-farm" type="submit">So sánh</button></div></div></form>
@if(Model.Left!=null && Model.Right!=null && Model.LeftId!=Model.RightId){<div class="alert alert-info">Nên chọn cùng loại cây, giống và cách đo. Sản lượng là tổng kg đã ghi, chưa quy đổi theo diện tích, số cây hay độ dài mùa vụ. Không dùng riêng số này để kết luận quy trình nào tốt hơn.</div>@if(Model.Left.Plant.PlantTypeId!=Model.Right.Plant.PlantTypeId || Model.Left.Plant.SeedId!=Model.Right.Plant.SeedId){<div class="alert alert-warning">Hai vụ khác loại cây hoặc giống; cần thận trọng khi đối chiếu.</div>}<div class="crop-comparison">@foreach(var m in new[]{Model.Left,Model.Right}){var p=m.Plant;<section class="card"><div class="card-header"><h2>@(p.SeasonName??p.BatchCode??"Chưa có tên")</h2><a asp-action="Details" asp-route-id="@p.Id">Mở sổ mùa vụ →</a></div><div class="card-body"><dl class="definition-grid"><div><dt>Loại cây / giống</dt><dd>@(p.PlantType?.Name??"Chưa rõ") / @(p.Seed?.Name??"Chưa rõ")</dd></div><div><dt>Vùng / ngày trồng</dt><dd>@(p.Area?.Name??"Chưa rõ") / @(p.PlantingDate?.ToString("dd/MM/yyyy")??"Chưa rõ")</dd></div><div><dt>Cây ban đầu</dt><dd>@(p.Quantity?.ToString("N0",vi)??"Chưa ghi")</dd></div><div><dt>Việc kế hoạch có nhật ký</dt><dd>@m.DoneSteps / @m.Steps.Count</dd></div><div><dt>Sản lượng đã ghi (kg)</dt><dd>@(m.HarvestKg?.ToString("N2",vi)??"Chưa đủ dữ liệu")</dd></div><div><dt>Tỷ lệ sống lần cuối</dt><dd>@(m.LatestObservation?.SurvivalPercent?.ToString("0.##",vi)??"Chưa đo") % · @(m.LatestObservation?.Date?.ToString("dd/MM/yyyy")??"Chưa có ngày")</dd></div></dl><h3 class="h6">Số lần ghi theo công việc</h3><ul>@foreach(var k in CropSeasonRules.Kinds){<li>@k.Value: @m.Timeline.Count(t=>t.Kind==k.Key) lần</li>}</ul><h3 class="h6">Quy trình</h3><p class="preserve-lines">@(p.CareProtocol??"Chưa mô tả")</p><h3 class="h6">Kinh nghiệm</h3><p class="preserve-lines">@(p.SeasonReview??"Chưa ghi")</p><h3 class="h6">Điều chỉnh mùa sau</h3><p class="preserve-lines">@(p.NextSeasonChanges??"Chưa ghi")</p></div></section>}</div>}else{<div class="card p-4"><p class="mb-0">Chọn hai mùa vụ rồi bấm “So sánh”. Nếu mới có một vụ, hãy tích lũy ghi chép; không cần nhập dữ liệu giả.</p></div>}

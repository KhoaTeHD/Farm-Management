@model IEnumerable<Farm_Management.Models.Plant>
@using Farm_Management.Services
@{ViewData["Title"]="Theo dõi cây trồng";var items=Model.ToList();var today=DateTime.Today;var active=items.Where(p=>p.Status=="Growing"||p.Status=="ReadyToHarvest").ToList();}
<div class="page-header"><div><p class="eyebrow">TỪ GIEO TRỒNG ĐẾN THU HOẠCH</p><h1>Theo dõi cây trồng</h1><p class="page-description">Mỗi lô là một mùa vụ: mở sổ để ghi chăm sóc, quan sát cây và rút kinh nghiệm.</p></div><a asp-action="Create" class="btn btn-farm">+ Thêm lô cây</a></div>
<div class="list-subnav mb-4"><a asp-action="Index" class="active">Lô cây / mùa vụ</a><a asp-action="Compare">So sánh mùa vụ</a><a asp-controller="PlantTypes" asp-action="Index">Loại cây</a><a asp-controller="Seeds" asp-action="Index">Giống cây</a></div><section class="stat-grid"><div class="stat-card"><div class="stat-top">Tổng lô cây</div><strong>@items.Count<span>lô</span></strong><small>Tất cả trạng thái đã ghi nhận</small></div><div class="stat-card"><div class="stat-top">Đang theo dõi</div><strong>@active.Count<span>lô</span></strong><small>Đang trồng hoặc sẵn sàng thu hoạch</small></div><div class="stat-card"><div class="stat-top">Đến ngày dự kiến</div><strong>@active.Count(p=>p.ExpectedHarvestDate.HasValue&&p.ExpectedHarvestDate.Value.Date<=today)<span>lô</span></strong><small>Cần kiểm tra thực tế trước khi thu hoạch</small></div><div class="stat-card"><div class="stat-top">Đã thu hoạch</div><strong>@items.Count(p=>p.Status=="Harvested")<span>lô</span></strong><small>Theo trạng thái được cập nhật</small></div></section>
<section class="card" data-list><div class="list-toolbar"><div class="search-field"><svg class="icon"><use href="#i-search"/></svg><input type="search" data-list-search class="form-control" placeholder="Tìm mã lô, loại cây, giống, vùng trồng…" aria-label="Tìm lô cây"/></div><div class="toolbar-controls"><select data-list-status class="form-select" aria-label="Lọc trạng thái lô cây"><option value="">Tất cả trạng thái</option>@foreach(var status in CropRules.Statuses){<option value="@status.Key">@status.Value</option>}<option value="unknown">Chưa rõ trạng thái</option></select></div></div>
@if(!items.Any()){<div class="empty-state"><svg class="icon empty-icon"><use href="#i-leaf"/></svg><h3>Bắt đầu theo dõi lô cây đầu tiên</h3><p>Chuẩn bị loại cây, giống và vùng trồng rồi ghi nhận ngày xuống giống.</p><a asp-action="Create" class="btn btn-farm">Thêm lô cây</a></div>}else{<div class="table-responsive"><table class="table table-responsive-card"><thead><tr><th>Lô cây</th><th>Vùng & nguồn giống</th><th>Ngày trồng</th><th>Dự kiến thu hoạch</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var p in items){var due=p.ExpectedHarvestDate.HasValue&&p.ExpectedHarvestDate.Value.Date<=today&&(p.Status=="Growing"||p.Status=="ReadyToHarvest");<tr data-list-row data-search="@p.SeasonName @p.BatchCode @p.PlantType?.Name @p.Seed?.Name @p.Area?.Name" data-status="@(p.Status!=null&&CropRules.Statuses.ContainsKey(p.Status)?p.Status:"unknown")"><td data-label="Lô cây"><a asp-action="Details" asp-route-id="@p.Id" class="fw-bold">@(p.SeasonName??p.BatchCode??"Thiếu mã lô")</a><small class="d-block text-muted">@p.BatchCode · @(p.PlantType?.Name??"Thiếu loại cây") · @(p.Quantity?.ToString()??"Chưa rõ số lượng") cây</small></td><td data-label="Vùng & giống">@(p.Area?.Name??"Thiếu vùng trồng")<small class="d-block text-muted">@(p.Seed?.Name??"Thiếu giống")</small></td><td data-label="Ngày trồng">@(p.PlantingDate?.ToString("dd/MM/yyyy")??"Thiếu ngày")@if(p.PlantingDate.HasValue&&p.PlantingDate.Value.Date<=today){<small class="d-block text-muted">@((today-p.PlantingDate.Value.Date).Days) ngày từ khi trồng</small>}</td><td data-label="Dự kiến">@(p.ExpectedHarvestDate?.ToString("dd/MM/yyyy")??"Chưa xác định")@if(due){<small class="d-block text-success">Đã đến ngày dự kiến</small>}</td><td data-label="Trạng thái"><span class="badge @(p.Status=="Growing"?"bg-success":p.Status=="ReadyToHarvest"?"bg-warning":p.Status=="Harvested"?"bg-info":"bg-secondary")">@CropRules.Label(p.Status)</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-farm">Theo dõi</a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Sửa</a></td></tr>}</tbody></table></div><div data-list-empty class="filter-empty" hidden>Không tìm thấy lô cây phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>}</section>

@model Farm_Management.Models.ViewModels.PlantForm
@{ViewData["Title"]=Model.Id==0?"Thêm lô cây":"Sửa lô cây";var types=(List<Farm_Management.Models.PlantType>)ViewBag.Types;var seeds=(List<Farm_Management.Models.Seed>)ViewBag.Seeds;}
<div class="page-header"><div><p class="eyebrow">THEO DÕI CÂY TRỒNG</p><h1>@ViewData["Title"]</h1><p class="page-description">Gắn mỗi lô cây với vùng trồng, giống và kế hoạch thu hoạch.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách lô cây</a></div>
<div class="form-layout"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card" method="post" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="ModelOnly"></div><h2 class="form-section-title">Mùa vụ này gọi là gì?</h2><label asp-for="SeasonName" class="form-label"></label><input asp-for="SeasonName" class="form-control" placeholder="Ví dụ: Cải vụ mưa 2026 - ruộng sau nhà"/><span asp-validation-for="SeasonName"></span><p class="form-text">Một lô ở đây là một lần trồng của một mùa vụ. Sang vụ sau tạo lô mới để giữ nguyên nhật ký vụ cũ.</p><label asp-for="CareProtocol" class="form-label"></label><textarea asp-for="CareProtocol" rows="3" class="form-control" placeholder="Ví dụ: kiểm tra độ ẩm đất trước tưới, thăm cây mỗi tuần."></textarea><span asp-validation-for="CareProtocol"></span>@if(Model.Id==0){<label asp-for="SourcePlantId" class="form-label mt-3"></label><select asp-for="SourcePlantId" class="form-select"><option value="">Không lấy kế hoạch cũ</option>@foreach(var old in (List<Farm_Management.Models.Plant>)ViewBag.Seasons){<option value="@old.Id">@(old.SeasonName??old.BatchCode??"Mùa vụ thiếu tên") · @old.BatchCode</option>}</select><span asp-validation-for="SourcePlantId"></span><p class="form-text">Chỉ lấy các việc dự kiến hợp lệ của mùa vụ cùng loại cây. Nhật ký, ảnh và kết quả cũ không được chép sang. Sau khi tạo hãy sửa kế hoạch theo kinh nghiệm đã rút ra.</p>}<h2 class="form-section-title">Lô cây & nguồn giống</h2><div class="row g-3"><div class="col-md-6"><label asp-for="BatchCode" class="form-label"></label><input asp-for="BatchCode" class="form-control"/><span asp-validation-for="BatchCode"></span></div><div class="col-md-6"><label asp-for="AreaId" class="form-label"></label><select asp-for="AreaId" asp-items="ViewBag.Areas" class="form-select"><option value="">-- Chọn vùng trồng --</option></select><span asp-validation-for="AreaId"></span></div><div class="col-md-6"><label asp-for="PlantTypeId" class="form-label"></label><select asp-for="PlantTypeId" class="form-select"><option value="">-- Chọn loại cây --</option>@foreach(var t in types){<option value="@t.Id" data-cycle="@t.GrowthCycleDays">@(t.Name??"Loại cây chưa có tên")</option>}</select><span asp-validation-for="PlantTypeId"></span></div><div class="col-md-6"><label asp-for="SeedId" class="form-label"></label><select asp-for="SeedId" class="form-select"><option value="">-- Chọn giống thuộc loại cây --</option>@foreach(var s in seeds){<option value="@s.Id" data-type="@s.PlantTypeId">@(s.Name??"Giống chưa có tên")</option>}</select><span asp-validation-for="SeedId"></span><p class="form-text" id="seed-help">Chỉ chọn giống thuộc loại cây đã chọn.</p></div></div></div><div class="form-section"><h2 class="form-section-title">Thời gian & trạng thái</h2><div class="row g-3"><div class="col-md-6"><label asp-for="PlantingDate" class="form-label"></label><input asp-for="PlantingDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/><span asp-validation-for="PlantingDate"></span></div><div class="col-md-6"><label asp-for="ExpectedHarvestDate" class="form-label"></label><input asp-for="ExpectedHarvestDate" type="date" class="form-control"/><span asp-validation-for="ExpectedHarvestDate"></span><button type="button" id="estimate-harvest" class="btn btn-sm btn-outline-secondary mt-2">Gợi ý theo chu kỳ</button><p class="form-text">Để trống sẽ tính từ chu kỳ nếu có. Ngày dự kiến không thay thế kiểm tra thực tế.</p></div><div class="col-md-6"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" type="number" min="1" step="1" class="form-control"/><span asp-validation-for="Quantity"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach(var status in Farm_Management.Services.CropRules.Statuses){<option value="@status.Key">@status.Value</option>}</select><span asp-validation-for="Status"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div></div></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu lô cây</button></div></form><aside class="form-aside"><h3>Chuẩn bị trước khi tạo lô</h3><ul><li><a asp-controller="Areas" asp-action="Create">Thêm vùng trồng</a> nếu chưa có khu đất.</li><li><a asp-controller="PlantTypes" asp-action="Create">Thêm loại cây</a> và chu kỳ sinh trưởng.</li><li><a asp-controller="Seeds" asp-action="Create">Thêm giống cây</a> tương ứng.</li></ul><p class="mt-3">Ngày dự kiến được gợi ý theo chu kỳ đã lưu. Bạn có thể điều chỉnh theo thực tế.</p><p>Thông tin cách ly thuốc được lấy từ nhật ký đã ghi nhận; không sửa bằng form này.</p></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/plants-form.js" asp-append-version="true"></script>}

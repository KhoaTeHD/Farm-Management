@model Farm_Management.Models.ViewModels.SeasonEvaluationForm
@{ViewData["Title"]="Kinh nghiệm mùa vụ";}
<div class="page-header"><div><p class="eyebrow">HỌC TỪ MÙA VỤ</p><h1>Ghi kinh nghiệm cho mùa sau</h1><p class="page-description">Đối chiếu sổ chăm sóc và kết quả, viết điều quan sát được cùng thay đổi muốn thử.</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">← Xem lại sổ mùa vụ</a></div><form class="card" method="post" asp-action="Evaluation" asp-route-id="@Model.Id" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><label asp-for="CareProtocol" class="form-label"></label><textarea asp-for="CareProtocol" class="form-control" rows="3" placeholder="Ví dụ: kiểm tra đất trước khi tưới, ghi tình trạng cây mỗi tuần."></textarea><label asp-for="SeasonReview" class="form-label mt-3"></label><textarea asp-for="SeasonReview" class="form-control" rows="5" placeholder="Ghi cây lớn nhanh/chậm lúc nào, sâu bệnh, chất lượng, sản lượng. Ví dụ: hàng trũng vàng lá sau mưa; chưa chắc do phân hay úng."></textarea><label asp-for="NextSeasonChanges" class="form-label mt-3"></label><textarea asp-for="NextSeasonChanges" class="form-control" rows="5" placeholder="Ví dụ: làm rãnh thoát nước trước trồng; giữ các bước khác giống vụ trước và quan sát lại sau mưa."></textarea><p class="form-text">Khác nhau giữa các vụ chưa chứng minh cách chăm sóc là nguyên nhân. Cần xét giống, đất, thời tiết, mật độ và cách đo.</p></div><partial name="_RecordChange"/><div class="form-actions"><button class="btn btn-farm" type="submit">Lưu kinh nghiệm</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

@model IEnumerable<Farm_Management.Models.Seed>
@{ViewData["Title"]="Giống cây";}
<div class="page-header"><div><p class="eyebrow">NGUỒN GIỐNG</p><h1>Giống cây</h1><p class="page-description">Theo dõi nguồn gốc, lô giống và chứng nhận đã ghi nhận.</p></div><a asp-action="Create" class="btn btn-farm">+ Thêm giống</a></div><div class="list-subnav mb-4"><a asp-controller="Plants" asp-action="Index">Lô cây</a><a asp-controller="PlantTypes" asp-action="Index">Loại cây</a><a asp-action="Index" class="active">Giống cây</a></div>
<section class="card" data-list><div class="list-toolbar"><div class="search-field"><svg class="icon"><use href="#i-search"/></svg><input type="search" class="form-control" data-list-search placeholder="Tìm giống, loại cây, nguồn gốc…" aria-label="Tìm giống cây"/></div><span class="result-count">@Model.Count() giống</span></div>@if(!Model.Any()){<div class="empty-state"><h3>Chưa có giống cây</h3><p>Thêm thông tin giống để sử dụng khi tạo lô cây.</p><a asp-action="Create" class="btn btn-outline-farm">Thêm giống đầu tiên</a></div>}else{<div class="table-responsive"><table class="table table-responsive-card"><thead><tr><th>Giống</th><th>Loại cây</th><th>Nguồn gốc</th><th>Chứng nhận</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr data-list-row data-search="@s.Name @s.PlantType?.Name @s.Origin @s.BatchNumber"><td data-label="Giống"><strong>@(s.Name??"Thiếu tên giống")</strong><small class="d-block text-muted">@(s.BatchNumber??"Chưa có số lô")</small></td><td data-label="Loại cây">@(s.PlantType?.Name??"Thiếu loại cây")</td><td data-label="Nguồn gốc">@(s.Origin??"Chưa cập nhật")</td><td data-label="Chứng nhận"><span class="badge @(s.IsCertified==true?"bg-success":"bg-secondary")">@(s.IsCertified==true?"Có chứng nhận":s.IsCertified==false?"Không có":"Chưa có thông tin")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-farm">Sửa</a> <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Xóa</a></td></tr>}</tbody></table></div><div class="filter-empty" data-list-empty hidden>Không có kết quả phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>}</section>

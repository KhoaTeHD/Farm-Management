@model Farm_Management.Models.ViewModels.SeedForm
@{ViewData["Title"]=Model.Id==0?"Thêm giống cây":"Sửa giống cây";}
<div class="page-header"><div><p class="eyebrow">NGUỒN GIỐNG</p><h1>@ViewData["Title"]</h1><p class="page-description">Lưu loại cây, nguồn gốc và thông tin lô giống để đối chiếu về sau.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách giống</a></div>
<div class="form-layout"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post" class="card" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="ModelOnly"></div><label asp-for="InputLotId" class="form-label"></label><select asp-for="InputLotId" asp-items="ViewBag.Inputs" class="form-select mb-3"><option value="">Chưa liên kết lô nhập giống</option></select><span asp-validation-for="InputLotId"></span><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="PlantTypeId" class="form-label"></label><select asp-for="PlantTypeId" asp-items="ViewBag.Types" class="form-select"><option value="">-- Chọn loại cây --</option></select><span asp-validation-for="PlantTypeId"></span></div><div class="col-12"><label asp-for="Origin" class="form-label"></label><input asp-for="Origin" class="form-control"/><span asp-validation-for="Origin"></span></div><div class="col-md-6"><label asp-for="BatchNumber" class="form-label"></label><input asp-for="BatchNumber" class="form-control"/><span asp-validation-for="BatchNumber"></span></div><div class="col-md-6"><label asp-for="InvoiceNumber" class="form-label"></label><input asp-for="InvoiceNumber" class="form-control"/><span asp-validation-for="InvoiceNumber"></span></div><div class="col-12"><label asp-for="IsCertified" class="form-label"></label><select asp-for="IsCertified" class="form-select"><option value="">Chưa có thông tin</option><option value="true">Có chứng nhận</option><option value="false">Không có chứng nhận</option></select></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="3" class="form-control"></textarea></div></div></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu giống cây</button></div></form><aside class="form-aside"><h3>Giống cần thuộc một loại cây.</h3><p>Chưa có loại cây phù hợp? <a asp-controller="PlantTypes" asp-action="Create">Thêm loại cây</a> rồi quay lại.</p><p>Giống đã được dùng trong lô cây không thể xóa hoặc chuyển sang loại cây không khớp.</p></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

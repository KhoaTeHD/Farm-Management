@model Farm_Management.Models.ViewModels.DashboardViewModel
@using Farm_Management.Services
@{ViewData["Title"]="Tổng quan";}
<div class="page-header"><div><p class="eyebrow">CHĂM CÂY HÔM NAY, RÚT KINH NGHIỆM CHO VỤ SAU</p><h1>Hôm nay vườn cây thế nào?</h1><p class="page-description">Chọn mùa vụ, ghi việc vừa làm và điều nhìn thấy ở cây. Mỗi ghi chép giúp bạn nhìn lại cách chăm sóc.</p></div><a asp-controller="Plants" asp-action="Index" class="btn btn-farm">Mở sổ cây trồng →</a></div>
<p class="mb-4"><a class="btn btn-outline-farm" href="#huong-dan">Chưa biết nhập liệu? Xem hướng dẫn từng bước ↓</a></p><section class="stat-grid"><a class="stat-card" asp-controller="Plants" asp-action="Index"><div class="stat-top">Mùa vụ đã tạo</div><strong>@Model.SeasonCount<span>mùa vụ</span></strong><small>Mỗi lần trồng là một hồ sơ riêng</small></a><a class="stat-card" asp-controller="Plants" asp-action="Index"><div class="stat-top">Đang chăm sóc</div><strong>@Model.GrowingSeasons<span>mùa vụ</span></strong><small>Đang trồng hoặc sẵn sàng thu hoạch</small></a><div class="stat-card"><div class="stat-top">Ghi chép trong sổ mới</div><strong>@Model.JournalCount<span>lần</span></strong><small>Gồm chăm sóc, quan sát và thu hoạch</small></div><a class="stat-card" asp-controller="Plants" asp-action="Compare"><div class="stat-top">Học từ các mùa vụ</div><strong class="crop-stat">Đối chiếu</strong><small>Xem kế hoạch, việc thực tế và kết quả</small></a></section>
<section class="card mb-4"><div class="card-header"><h2 class="mb-0">Sổ mùa vụ của bạn</h2></div><div class="card-body">@if(!Model.Seasons.Any()){<p>Chưa có mùa vụ. Làm theo phần hướng dẫn ngay bên dưới; bạn chỉ cần nhập thông tin đang biết.</p><a class="btn btn-farm" asp-controller="Plants" asp-action="Create">+ Tạo mùa vụ đầu tiên</a>}else{<div class="crop-season-grid">@foreach(var s in Model.Seasons){<article class="crop-season-card"><span class="badge bg-secondary">@CropRules.Label(s.Plant.Status)</span><h3>@(s.Plant.SeasonName??s.Plant.BatchCode??"Hồ sơ chưa có tên")</h3><p>@(s.Plant.PlantType?.Name??"Chưa có loại cây") · Trồng @(s.Plant.PlantingDate?.ToString("dd/MM/yyyy")??"chưa ghi ngày")</p><p>@s.DueSteps việc dự kiến đến ngày chưa ghi · @s.Entries.Count lần trong sổ mới</p><div class="crop-actions"><a asp-controller="Plants" asp-action="Details" asp-route-id="@s.Plant.Id" class="btn btn-sm btn-outline-farm">Mở sổ</a><a asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@s.Plant.Id" class="btn btn-sm btn-farm">+ Ghi hôm nay</a></div></article>}</div><a asp-controller="Plants" asp-action="Index" class="text-link mt-3 d-inline-block">Xem tất cả mùa vụ →</a>}</div></section>
<section class="card farmer-guide mb-4" id="huong-dan"><div class="card-header"><p class="eyebrow">LẦN ĐẦU SỬ DỤNG? BẮT ĐẦU TẠI ĐÂY</p><h2>Hướng dẫn ghi sổ từng bước</h2><p class="mb-0">Không cần biết nhiều về máy tính. Bấm nút đúng bước, nhập theo ví dụ rồi bấm “Lưu”. Ví dụ dưới đây để hiểu cách ghi, không phải lịch bón phân hoặc phun thuốc.</p></div><div class="card-body"><ol class="farmer-steps">
<li><h3>Chuẩn bị nơi trồng, loại cây và giống</h3><p><strong>Vùng trồng</strong> là mảnh đất của bạn, ví dụ “Ruộng sau nhà”. Nhập tên, diện tích nếu biết; vị trí bản đồ có thể bổ sung sau.</p><p><strong>Loại cây</strong> là cải, cà chua, xoài… <strong>Giống</strong> là tên giống hoặc tên trên bao hạt. Ghi nơi mua để mùa sau biết giống nào cho kết quả ra sao. Chu kỳ sinh trưởng chưa rõ thì để trống.</p><div class="crop-actions"><a asp-controller="Areas" asp-action="Create">1. Thêm vùng trồng</a><a asp-controller="PlantTypes" asp-action="Create">2. Thêm loại cây</a><a asp-controller="Seeds" asp-action="Create">3. Thêm giống</a></div></li>
<li><h3>Tạo một hồ sơ cho lần trồng này</h3><p>Bấm <strong>“Thêm lô cây”</strong>. Đặt tên dễ nhớ, ví dụ “Cải vụ mưa 2026 - ruộng sau nhà”; chọn vùng, loại cây và giống vừa tạo. Ngày trồng là ngày xuống giống thực tế, số cây chỉ nhập khi biết.</p><p>Mã lô đã có sẵn, bạn có thể giữ nguyên. Ngày dự kiến thu hoạch chỉ là dự kiến, có thể để trống nếu chưa biết. Chưa thu xong thì giữ “Đang trồng”. <strong>Sang vụ mới tạo hồ sơ mới, không đổi tên vụ cũ để dùng lại.</strong></p><a class="btn btn-outline-farm" asp-controller="Plants" asp-action="Create">+ Tạo lô cây / mùa vụ</a></li>
<li><h3>Ghi những việc dự định làm</h3><p>Mở hồ sơ mùa vụ, bấm <strong>“Thêm việc dự kiến”</strong>. Viết tên việc, ngày muốn làm và cách kiểm tra. Ngày trồng là <strong>ngày 0</strong>; ngày 7 nghĩa là một tuần sau trồng.</p><p>Ví dụ: “Ngày 7: kiểm tra cây sống; đếm ở 3 hàng và chụp ảnh”. Chỉ ghi kế hoạch phù hợp với vườn mình. Khi tạo vụ sau có thể lấy kế hoạch vụ trước rồi điều chỉnh.</p></li>
<li><h3>Chuẩn bị vật tư và nguồn nước trước khi ghi chăm sóc</h3><p>Mở <a asp-controller="FarmRecords" asp-action="Index">Vật tư & kiểm nghiệm</a>. Mỗi lô phân/thuốc/giống ghi mã trên bao bì, nơi mua, ngày nhận, hạn dùng và lượng nhận. Tạo nguồn nước/đất cho từng vùng, ghi nguy cơ và cách xử lý. Người phụ trách kiểm tra rồi mới chọn “Cho sử dụng”.</p><p>Có phiếu kiểm nghiệm thì chọn đúng đối tượng, chép kết quả, chỉ tiêu, ngưỡng theo phiếu và tải PDF/ảnh. Chưa có phiếu không có nghĩa đã đạt. Kết quả không đạt hoặc chưa rõ sẽ tạm giữ nguồn/vật tư; sau xử lý thêm phiếu mới cùng tên chỉ tiêu.</p></li><li><h3>Làm xong việc nào, ghi ngay việc đó</h3><p>Bấm <strong>“Ghi việc đã làm”</strong>, chọn tưới nước, bón phân, dùng thuốc hoặc chăm sóc khác. Chọn đúng ngày đã làm, ghi tên người làm, cách làm và kết quả nhìn thấy.</p><p><strong>Lượng dùng là tổng lượng cho cả lô trong lần đó.</strong> Ví dụ tưới 200 lít cho cả lô thì ghi 200 và chọn lít; không ghi 200 nếu đó chỉ là lượng cho một gốc. Thuốc/phân ghi đúng tên trên bao bì. Dùng thuốc phải ghi số ngày cách ly theo nhãn; chưa rõ thì hỏi người phụ trách, không đoán là 0.</p><p>Chọn việc trong kế hoạch nếu lần này thực hiện việc đó. Việc phát sinh thì để trống mục kế hoạch. Có thể chọn ảnh từ điện thoại; tối đa 5 MB. Bấm <strong>“Lưu vào sổ mùa vụ”</strong>, sau đó kiểm tra ghi chép vừa xuất hiện trong sổ.</p></li>
<li><h3>Thăm vườn và ghi cây lớn lên thế nào</h3><p>Bấm <strong>“Ghi tình trạng cây”</strong>. Chọn cây con / thân lá / ra hoa / nuôi quả / gần thu hoạch; chọn phát triển tốt, cần theo dõi hoặc có vấn đề. Mô tả lá, thân, sâu bệnh, đất và điều bất thường.</p><p>Nếu có đo, ghi chiều cao bằng cm. Ví dụ kiểm tra 100 cây, 95 cây còn sống thì ghi tỷ lệ sống 95%. Chưa đếm, chưa đo thì <strong>để trống, không nhập 0</strong>. Nên quan sát cùng hàng cây, cùng cách đo qua các lần; chụp cùng góc để dễ nhìn lại.</p><p>Ví dụ mô tả: “Cây cao khoảng 12 cm, có 4–5 lá. Góc thấp bị vàng lá sau mưa; sẽ kiểm tra thoát nước”. Mỗi lần thăm vườn thêm một ghi chép mới; chỉ bấm Sửa khi ghi nhầm.</p></li>
<li><h3>Thu hoạch, nhìn lại và chỉnh cho mùa sau</h3><p>Mỗi đợt hái/cắt, chọn <strong>“Thu hoạch”</strong>, nhập ngày, sản lượng bằng kg và chất lượng. Ví dụ “35 kg, lá đều, một ít bị sâu”. Phần mềm kiểm tra mốc cách ly đã ghi; vẫn cần kiểm tra thực tế và làm đúng nhãn sản phẩm.</p><p>Thu xong toàn bộ mới đổi trạng thái lô thành “Đã thu hoạch”. Bấm <strong>“Ghi kinh nghiệm mùa này”</strong>: bước nào có kết quả tốt, lúc nào cây yếu, mùa sau sẽ đổi việc gì. Chọn “So với mùa khác” để xem hai sổ cạnh nhau. Khác kết quả có thể do giống, đất, thời tiết và nhiều yếu tố, không nên kết luận chỉ do một lần bón/tưới.</p><a asp-controller="Plants" asp-action="Compare" class="btn btn-outline-farm">Đối chiếu mùa vụ</a></li>
<li><h3>Tra cứu thu hoạch và giữ lịch sử</h3><p>Mỗi đợt thu hoạch mới có một mã riêng ở <a asp-controller="HarvestTrace" asp-action="Index">Truy xuất thu hoạch</a>. Nhập mã để xem nguồn giống, vật tư, nguồn nước và nhật ký đã lưu. Nếu sửa sổ sau khi cấp mã, bản cũ vẫn được giữ; cần đối chiếu rồi cập nhật bản truy xuất có lý do.</p><p>Sửa/lưu trữ hồ sơ phải ghi tên người nhập và lý do. Mở <a asp-controller="RecordHistory" asp-action="Index">Lịch sử & lưu hồ sơ</a> để xem trước/sau hoặc khôi phục bản ghi đã ẩn. Ứng dụng giữ toàn bộ dữ liệu và tệp, không tự xóa sau 24 tháng.</p></li></ol><div class="inline-notice neutral"><strong>Nhập sai phải làm sao?</strong> Mở đúng mùa vụ, tìm dòng trong “Sổ chăm sóc theo thời gian”, bấm “Sửa ghi chép”, chỉnh rồi Lưu. “Chuyển vào lưu trữ” dùng khi ghi thừa và vẫn có thể khôi phục. Nếu ô báo lỗi màu đỏ, đọc dòng hướng dẫn, sửa chỗ đó rồi bấm Lưu lại; dữ liệu chưa lưu sẽ không có trong sổ.</div></div></section>
<details class="card crop-help"><summary>Công nhân, chấm công và tiền lương</summary><div><p>Các chức năng hỗ trợ vẫn ở menu. Thêm công nhân, ghi giờ làm theo ngày; cuối tháng kiểm tra bảng lương và các phiếu tạm ứng rồi chốt.</p><div class="crop-actions"><a asp-controller="Workers" asp-action="Index">Công nhân</a><a asp-controller="Attendance" asp-action="Calendar">Chấm công</a><a asp-controller="Payroll" asp-action="Index">Bảng lương</a><a asp-controller="Advances" asp-action="Index">Tạm ứng</a></div></div></details>

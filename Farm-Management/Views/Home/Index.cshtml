@model Farm_Management.Models.ViewModels.DashboardViewModel
@using Farm_Management.Services
@{
    ViewData["Title"] = "Tổng quan";
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<div class="page-header">
    <div>
        <p class="eyebrow">QUẢN LÝ NÔNG TRẠI ĐƠN GIẢN</p>
        <h1>Hôm nay vườn cây thế nào?</h1>
        <p class="page-description">Chọn danh mục vật liệu có sẵn, ghi việc làm hằng ngày và gán cho 1 hoặc nhiều công nhân thực hiện.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="CropJournal" asp-action="Create" asp-route-returnUrl="/" class="btn btn-farm">+ Ghi việc hôm nay</a>
        <a asp-controller="Plants" asp-action="Index" class="btn btn-outline-farm">Mở sổ cây trồng →</a>
    </div>
</div>

<p class="mb-4"><a class="btn btn-outline-secondary btn-sm" href="#huong-dan">Xem hướng dẫn nhanh 4 bước ↓</a></p>

<section class="stat-grid">
    <a class="stat-card" asp-controller="Plants" asp-action="Index">
        <div class="stat-top">Đang chăm sóc</div>
        <strong>@Model.GrowingSeasons<span>/ @Model.SeasonCount vụ</span></strong>
        <small>Mùa vụ đang trồng hoặc chờ thu hoạch</small>
    </a>
    <a class="stat-card" asp-controller="CropJournal" asp-action="Index">
        <div class="stat-top">Việc hằng ngày</div>
        <strong>@Model.TodayWorkCount<span>việc hôm nay</span></strong>
        <small>Tổng @Model.JournalCount công việc đã ghi</small>
    </a>
    <a class="stat-card" asp-controller="Materials" asp-action="Index">
        <div class="stat-top">Danh mục vật liệu</div>
        <strong>@Model.MaterialCount<span>loại</span></strong>
        <small>Phân gà, phân bò, thuốc trừ sâu…</small>
    </a>
    <a class="stat-card" asp-controller="Workers" asp-action="Index">
        <div class="stat-top">Công nhân</div>
        <strong>@Model.ActiveWorkerCount<span>người</span></strong>
        <small>Đang làm việc và sẵn sàng gán việc</small>
    </a>
</section>

<section class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="mb-0">Công việc mới ghi gần đây</h2>
        <a asp-controller="CropJournal" asp-action="Index" class="btn btn-sm btn-outline-farm">Xem tất cả việc hằng ngày →</a>
    </div>
    @if (!Model.RecentWorks.Any())
    {
        <div class="card-body">
            <p class="mb-2">Chưa có công việc nào được ghi. Hãy tạo mùa vụ, thêm danh mục vật liệu và bắt đầu ghi việc hằng ngày.</p>
            <a asp-controller="CropJournal" asp-action="Create" asp-route-returnUrl="/" class="btn btn-farm btn-sm">+ Ghi việc đầu tiên</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-responsive-card">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th>Mùa vụ</th>
                        <th>Công việc</th>
                        <th>Vật liệu & lượng</th>
                        <th>Công nhân thực hiện</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.RecentWorks)
                    {
                        var e = row.Entry;
                        var amountText = e.Amount.HasValue
                            ? e.Amount.Value.ToString("0.##", vi) + (string.IsNullOrWhiteSpace(e.Unit) ? "" : " " + e.Unit)
                            : null;
                        <tr>
                            <td data-label="Ngày"><strong>@(e.Date?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</strong></td>
                            <td data-label="Mùa vụ">
                                @if (e.PlantId.HasValue)
                                {
                                    <a asp-controller="Plants" asp-action="Details" asp-route-id="@e.PlantId">@(row.PlantName ?? $"Mùa vụ #{e.PlantId}")</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td data-label="Công việc">@CropSeasonRules.KindLabel(e.Kind)</td>
                            <td data-label="Vật liệu">
                                @(string.IsNullOrWhiteSpace(row.MaterialDisplay) ? "—" : row.MaterialDisplay)
                                @if (!string.IsNullOrWhiteSpace(amountText))
                                {
                                    <small class="d-block text-muted">@amountText</small>
                                }
                            </td>
                            <td data-label="Công nhân">
                                @if (row.WorkerNames.Any())
                                {
                                    <div class="worker-badge-list">
                                        @foreach (var wn in row.WorkerNames)
                                        {
                                            <span class="worker-badge">@wn</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa gán</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card mb-4">
    <div class="card-header"><h2 class="mb-0">Sổ mùa vụ của bạn</h2></div>
    <div class="card-body">
        @if (!Model.Seasons.Any())
        {
            <p>Chưa có mùa vụ. Làm theo 4 bước ngắn gọn bên dưới để bắt đầu.</p>
            <a class="btn btn-farm" asp-controller="Plants" asp-action="Create">+ Tạo mùa vụ đầu tiên</a>
        }
        else
        {
            <div class="crop-season-grid">
                @foreach (var s in Model.Seasons)
                {
                    <article class="crop-season-card">
                        <span class="badge bg-secondary">@CropRules.Label(s.Plant.Status)</span>
                        <h3>@(s.Plant.SeasonName ?? s.Plant.BatchCode ?? "Hồ sơ chưa có tên")</h3>
                        <p>@(s.Plant.PlantType?.Name ?? "Chưa có loại cây") · Trồng @(s.Plant.PlantingDate?.ToString("dd/MM/yyyy") ?? "chưa ghi ngày")</p>
                        <p>@s.Entries.Count công việc đã ghi</p>
                        <div class="crop-actions">
                            <a asp-controller="Plants" asp-action="Details" asp-route-id="@s.Plant.Id" class="btn btn-sm btn-outline-farm">Mở sổ</a>
                            <a asp-controller="CropJournal" asp-action="Create" asp-route-plantId="@s.Plant.Id" asp-route-returnUrl="/" class="btn btn-sm btn-farm">+ Ghi hôm nay</a>
                        </div>
                    </article>
                }
            </div>
            <a asp-controller="Plants" asp-action="Index" class="text-link mt-3 d-inline-block">Xem tất cả mùa vụ →</a>
        }
    </div>
</section>

<section class="card farmer-guide mb-4" id="huong-dan">
    <div class="card-header">
        <p class="eyebrow">HƯỚNG DẪN NHANH</p>
        <h2>4 bước quản lý nông trại gọn nhẹ</h2>
    </div>
    <div class="card-body">
        <ol class="farmer-steps">
            <li>
                <h3>Chuẩn bị vùng trồng, loại cây, giống và công nhân</h3>
                <p>Nhập sẵn mảnh đất (<a asp-controller="Areas" asp-action="Create">Vùng trồng</a>), loại cây/giống và danh sách <a asp-controller="Workers" asp-action="Create">Công nhân</a> để khi ghi việc chỉ cần chọn.</p>
            </li>
            <li>
                <h3>Tạo danh mục vật liệu hay dùng</h3>
                <p>Vào <a asp-controller="Materials" asp-action="Index">Danh mục vật liệu</a> để thêm tên các loại phân, thuốc (ví dụ: <strong>Phân gà</strong>, <strong>Phân bò</strong>, <strong>Thuốc trừ sâu Nhật</strong>…). Không cần nhập số lô phức tạp.</p>
            </li>
            <li>
                <h3>Tạo mùa vụ cho đợt trồng mới</h3>
                <p>Bấm <a asp-controller="Plants" asp-action="Create">+ Thêm lô cây</a>, chọn vùng trồng, loại cây, giống và ngày xuống giống.</p>
            </li>
            <li>
                <h3>Ghi việc hằng ngày & gán 1 hoặc nhiều công nhân</h3>
                <p>Mở <a asp-controller="CropJournal" asp-action="Index">Việc hằng ngày</a> hoặc bấm <strong>+ Ghi việc hôm nay</strong>: chọn mùa vụ, ngày, loại việc, chọn vật liệu từ danh mục (khi bón phân/phun thuốc) và tích chọn 1 hoặc nhiều công nhân làm việc. Số lượng và ghi chú nhập thêm nếu muốn.</p>
            </li>
        </ol>
    </div>
</section>

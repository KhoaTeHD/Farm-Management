@model IEnumerable<Farm_Management.Models.PlantType>
@{ViewData["Title"]="Loại cây";}
<div class="page-header"><div><p class="eyebrow">DANH MỤC CÂY TRỒNG</p><h1>Loại cây</h1><p class="page-description">Phân nhóm cây trồng và lưu chu kỳ sinh trưởng để lập lịch theo dõi.</p></div><a asp-action="Create" class="btn btn-farm">+ Thêm loại cây</a></div>
<div class="list-subnav mb-4"><a asp-controller="Plants" asp-action="Index">Lô cây</a><a asp-action="Index" class="active">Loại cây</a><a asp-controller="Seeds" asp-action="Index">Giống cây</a></div><section class="card" data-list><div class="list-toolbar"><div class="search-field"><svg class="icon"><use href="#i-search"/></svg><input type="search" class="form-control" data-list-search placeholder="Tìm loại cây…" aria-label="Tìm loại cây"/></div><span class="result-count">@Model.Count() loại</span></div>@if(!Model.Any()){<div class="empty-state"><h3>Chưa có loại cây</h3><p>Thêm loại cây trước khi tạo giống và lô cây.</p><a asp-action="Create" class="btn btn-outline-farm">Thêm loại cây đầu tiên</a></div>}else{<div class="table-responsive"><table class="table table-responsive-card"><thead><tr><th>Loại cây</th><th>Chu kỳ</th><th>Mô tả</th><th></th></tr></thead><tbody>@foreach(var t in Model){<tr data-list-row data-search="@t.Name @t.Description"><td data-label="Loại cây"><strong>@(t.Name??"Thiếu tên")</strong></td><td data-label="Chu kỳ">@(t.GrowthCycleDays?.ToString()??"Chưa xác định") @(t.GrowthCycleDays.HasValue?"ngày":"")</td><td data-label="Mô tả">@(t.Description??"—")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-farm">Sửa</a> <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Xóa</a></td></tr>}</tbody></table></div><div class="filter-empty" data-list-empty hidden>Không có kết quả phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>}</section>

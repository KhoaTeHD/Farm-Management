@model Farm_Management.Models.ViewModels.PlantTypeForm
@{ViewData["Title"]=Model.Id==0?"Thêm loại cây":"Sửa loại cây";}
<div class="page-header"><div><p class="eyebrow">DANH MỤC CÂY TRỒNG</p><h1>@ViewData["Title"]</h1><p class="page-description">Chu kỳ sinh trưởng dùng để gợi ý ngày thu hoạch khi tạo lô cây mới.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách loại cây</a></div>
<form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card form-container-center" method="post" data-save-form><input asp-for="Id" type="hidden"/><div class="form-section"><div asp-validation-summary="ModelOnly"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="VD: Cải xanh"/><span asp-validation-for="Name"></span></div><div class="mb-3"><label asp-for="GrowthCycleDays" class="form-label"></label><input asp-for="GrowthCycleDays" type="number" min="1" max="36500" step="1" class="form-control"/><span asp-validation-for="GrowthCycleDays"></span><p class="form-text">Có thể để trống khi chưa xác định chu kỳ. Không tự thay đổi ngày dự kiến của các lô đã có.</p></div><div><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu loại cây</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

@model Farm_Management.Models.ViewModels.AdvanceListViewModel
@{ ViewData["Title"]="Tạm ứng công nhân";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-header"><div><p class="eyebrow">TẠM ỨNG & KHẤU TRỪ</p><h1>Tạm ứng công nhân</h1><p class="page-description">Quản lý từng phiếu ứng và đối chiếu khoản trừ trên bảng lương tháng.</p></div><a asp-action="Create" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-farm">+ Thêm tạm ứng</a></div>
<div class="day-navigation"><div class="list-subnav"><a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="@(!Model.Incomplete?"active":"")">Theo tháng khấu trừ</a><a asp-action="Index" asp-route-incomplete="true" class="@(Model.Incomplete?"active":"")">Cần bổ sung</a></div><form method="get" class="calendar-controls"><label for="advance-month" class="visually-hidden">Tháng khấu trừ</label><select id="advance-month" name="month" class="form-select">@for(var m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Month)">Tháng @m</option>}</select><input type="number" name="year" min="2" max="9998" value="@Model.Year" class="form-control" aria-label="Năm khấu trừ" style="width:95px"/><button type="submit" class="btn btn-outline-farm">Xem tháng</button><a asp-controller="Payroll" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Bảng lương</a></form></div>
@if(Model.Locked && !Model.Incomplete){<div class="alert alert-info">Tháng đã chốt. Các phiếu thuộc tháng này được khóa; mở lại bảng lương để điều chỉnh.</div>}
<section class="card" data-list><div class="list-toolbar"><div class="search-field"><svg class="icon"><use href="#i-search"/></svg><input type="search" data-list-search class="form-control" placeholder="Tìm mã phiếu, tên công nhân…" aria-label="Tìm phiếu tạm ứng" /></div><span class="result-count">@Model.Items.Count phiếu</span></div>@if(!Model.Items.Any()){<div class="empty-state"><svg class="icon empty-icon"><use href="#i-list"/></svg><h3>Chưa có phiếu tạm ứng phù hợp</h3><p>Các phiếu sẽ được khấu trừ đúng tháng đã chọn trên từng phiếu.</p></div>}else{<div class="table-responsive"><table class="table table-responsive-card"><thead><tr><th>Phiếu ứng</th><th>Công nhân</th><th>Ngày ứng</th><th>Tháng trừ</th><th class="text-end">Số tiền</th><th>Ghi chú</th><th></th></tr></thead><tbody>@foreach(var a in Model.Items){var worker=a.WorkerId.HasValue?Model.Workers.GetValueOrDefault(a.WorkerId.Value):null;<tr data-list-row data-search="@a.Reference @worker?.Code @worker?.FullName"><td data-label="Mã phiếu"><strong>@(a.Reference??"Thiếu mã phiếu")</strong></td><td data-label="Công nhân">@(worker?.FullName??"Thiếu công nhân")<small class="d-block text-muted">@worker?.Code</small></td><td data-label="Ngày ứng">@(a.PaidDate?.ToString("dd/MM/yyyy")??"Thiếu ngày")</td><td data-label="Tháng khấu trừ">@(a.PayrollMonth?.ToString("00")??"—")/@(a.PayrollYear?.ToString()??"—")</td><td data-label="Số tiền" class="text-end"><strong>@(a.Amount?.ToString("N0",vi)??"Thiếu số tiền") đ</strong></td><td data-label="Ghi chú">@(a.Notes??"—")</td><td class="text-end"><div class="d-flex gap-2 justify-content-end"><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-farm">Sửa</a><a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Xóa</a></div></td></tr>}</tbody></table></div><div class="filter-empty" data-list-empty hidden>Không tìm thấy phiếu phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>}</section>

@model Farm_Management.Models.ViewModels.AdvanceForm
@{ ViewData["Title"] = Model.Id==0?"Thêm tạm ứng":"Sửa tạm ứng"; }
<div class="page-header"><div><p class="eyebrow">TẠM ỨNG & KHẤU TRỪ</p><h1>@ViewData["Title"]</h1><p class="page-description">Ghi nhận phiếu ứng và chọn tháng sẽ trừ khoản tiền này vào lương.</p></div><a asp-action="Index" asp-route-year="@Model.PayrollYear" asp-route-month="@Model.PayrollMonth" class="btn btn-outline-secondary">← Danh sách tạm ứng</a></div>
<div class="form-layout"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post" class="card" data-save-form><input asp-for="Id" type="hidden" /><div class="form-section"><div asp-validation-summary="ModelOnly"></div>@if(ViewBag.Locked==true){<div class="alert alert-warning">Tháng này đã chốt lương. Cần mở lại tháng trước khi sửa khoản ứng.</div>}<h2 class="form-section-title">Thông tin phiếu tạm ứng</h2><div class="row g-3"><div class="col-12"><label asp-for="WorkerId" class="form-label"></label><select asp-for="WorkerId" asp-items="ViewBag.WorkerOptions" class="form-select"><option value="">-- Chọn công nhân --</option></select><span asp-validation-for="WorkerId"></span></div><div class="col-md-6"><label asp-for="Reference" class="form-label"></label><input asp-for="Reference" class="form-control" autocomplete="off" /><span asp-validation-for="Reference"></span></div><div class="col-md-6"><label asp-for="PaidDate" class="form-label"></label><input asp-for="PaidDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="PaidDate"></span></div><div class="col-12"><label asp-for="Amount" class="form-label"></label><div class="input-group"><input asp-for="Amount" type="number" min="1" max="1000000000" step="1" inputmode="numeric" class="form-control" placeholder="500000" /><span class="input-group-text">đ</span></div><span asp-validation-for="Amount"></span></div><div class="col-md-6"><label asp-for="PayrollMonth" class="form-label"></label><select asp-for="PayrollMonth" class="form-select">@for(var m=1;m<=12;m++){<option value="@m">Tháng @m</option>}</select><span asp-validation-for="PayrollMonth"></span></div><div class="col-md-6"><label asp-for="PayrollYear" class="form-label"></label><input asp-for="PayrollYear" type="number" min="2" max="9998" class="form-control" /><span asp-validation-for="PayrollYear"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="500"></textarea><span asp-validation-for="Notes"></span></div></div></div><div class="form-actions"><a asp-action="Index" asp-route-year="@Model.PayrollYear" asp-route-month="@Model.PayrollMonth" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu phiếu tạm ứng</button></div></form><aside class="form-aside"><h3>Rõ khoản ứng, đúng tháng trừ.</h3><ul><li>Mỗi phiếu có mã riêng để tránh ghi nhận hai lần.</li><li>Ngày ứng là ngày đã phát sinh; tháng khấu trừ có thể khác tháng ứng.</li><li>Tháng đã chốt không được thêm, sửa hoặc xóa phiếu.</li><li>Nếu ứng vượt lương, cần điều chỉnh trước khi chốt; hệ thống không tự chuyển nợ.</li></ul><p class="mt-3 mb-0">Chức năng này ghi sổ tạm ứng, không thực hiện chuyển tiền.</p></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}

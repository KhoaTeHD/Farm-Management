@model Farm_Management.Models.WorkerAdvance
@{ViewData["Title"]="Xóa phiếu tạm ứng";var worker=ViewBag.Worker as Farm_Management.Models.Worker;}
<section class="card danger-panel"><div class="card-body"><p class="eyebrow">KIỂM TRA PHIẾU ỨNG</p><h1>Xóa phiếu tạm ứng?</h1><dl class="definition-grid mt-4"><div><dt>Mã phiếu</dt><dd>@(Model.Reference??"Thiếu mã")</dd></div><div><dt>Công nhân</dt><dd>@(worker?.FullName??"Thiếu công nhân")</dd></div><div><dt>Số tiền</dt><dd>@(Model.Amount?.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))??"—") đ</dd></div><div><dt>Tháng khấu trừ</dt><dd>@Model.PayrollMonth/@Model.PayrollYear</dd></div></dl><div class="inline-notice">Phiếu sẽ bị bỏ khỏi bản tạm tính. Bản chốt cũ vẫn giữ nguyên số tiền và nội dung phiếu đã lưu.</div>@if(ViewBag.Locked==true){<div class="alert alert-warning mt-3">Tháng đã chốt lương; cần mở lại trước khi xóa.</div>}</div><form asp-action="Delete" method="post" class="form-actions" data-save-form><input type="hidden" name="id" value="@Model.Id"/><a asp-action="Index" asp-route-year="@Model.PayrollYear" asp-route-month="@Model.PayrollMonth" class="btn btn-outline-secondary">Giữ lại</a><button type="submit" class="btn btn-danger" disabled="@(ViewBag.Locked==true)">Xác nhận xóa phiếu</button></form></section>

<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Thiên Mỹ Farm</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="auth-page"><main class="auth-card"><p class="eyebrow">THIÊN MỸ FARM</p><h1>@ViewData["Title"]</h1>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@RenderBody()</main><script src="~/lib/jquery/dist/jquery.min.js"></script>@await RenderSectionAsync("Scripts", false)</body></html>

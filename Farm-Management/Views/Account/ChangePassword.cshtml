@model Farm_Management.Models.ViewModels.ChangePasswordForm
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đổi mật khẩu"; }
<p class="text-muted">Lần đầu đăng nhập hoặc sau khi được cấp lại mật khẩu, bạn cần đặt mật khẩu riêng trước khi vào trang trại.</p>
<form asp-action="ChangePassword" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required/></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" minlength="12" maxlength="128" required/><p class="form-text">Dùng 12–128 ký tự, có cả chữ và số. Bạn có thể dùng một câu dễ nhớ.</p></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required/></div>
<button class="btn btn-farm w-100" type="submit">Lưu mật khẩu mới</button></form>
<form asp-action="Logout" method="post" class="mt-3"><button class="btn btn-outline-secondary w-100" type="submit">Đăng xuất</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }

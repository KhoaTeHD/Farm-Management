@{var editing=ViewData["ChangeIsEdit"] as bool? == true;var request=ViewContext.HttpContext.Request;var actor=request.HasFormContentType?request.Form["ChangedBy"].ToString():"";var reason=request.HasFormContentType?request.Form["ChangeReason"].ToString():"";}
<div class="form-section record-change"><h2 class="form-section-title">Người ghi và lý do</h2><input type="hidden" name="OriginalRevision" value="@(ViewData["RecordRevision"]??0)"/><label class="form-label" for="ChangedBy">Tên người đang nhập hồ sơ</label><input id="ChangedBy" name="ChangedBy" value="@actor" required maxlength="100" class="form-control" placeholder="Ví dụ: Nguyễn Văn Ba"/><label class="form-label mt-2" for="ChangeReason">@(editing?"Lý do thay đổi (bắt buộc)":"Ghi chú khi tạo hồ sơ (nếu có)")</label><textarea id="ChangeReason" name="ChangeReason" required="@editing" maxlength="1000" class="form-control" placeholder="Ví dụ: sửa số lượng bị gõ nhầm, đối chiếu lại sổ giấy">@reason</textarea><p class="form-text">Tên do người nhập tự khai, chưa được xác thực bằng tài khoản. Nội dung cũ được giữ trong lịch sử; không tự xóa hồ sơ hoặc tệp minh chứng.</p></div>

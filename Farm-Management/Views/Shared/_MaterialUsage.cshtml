@model Farm_Management.Models.ViewModels.MaterialUsageTableViewModel
@using Farm_Management.Services
@{
    var rows = Model.Rows.OrderByDescending(r => r.Date).ThenBy(r => r.Kind).ToList();
}
<section class="card mb-4 material-usage-section" data-list data-page-size="15" id="material-usage">
    <div class="card-header">
        <h2 class="mb-0">Vật liệu đã dùng</h2>
        <p class="mb-0 mt-2">@(Model.IsSnapshot ? "Thông tin của từng lần sử dụng trong bản truy xuất đã lưu." : "Tổng hợp các lần bón phân, phun thuốc và dùng vật liệu của mùa vụ này.")</p>
    </div>
    @if (Model.OlderLegacySnapshot)
    {
        <div class="card-body"><p class="text-warning mb-0">Bản truy xuất cũ chưa lưu bảng chi tiết thuốc/phân từ sổ cũ. Xem nguyên văn sổ cũ bên dưới.</p></div>
    }
    @if (!rows.Any())
    {
        <div class="card-body"><p class="mb-0">Chưa có lần dùng vật liệu nào được ghi trong @(Model.IsSnapshot ? "bản lưu này" : "sổ mùa vụ này").</p></div>
    }
    else
    {
        <div class="list-toolbar">
            <input type="search" data-list-search class="form-control" aria-label="Tìm vật liệu đã dùng" placeholder="Tìm tên vật liệu hoặc công nhân…" />
            <select data-list-status class="form-select list-filter" aria-label="Lọc nhóm vật liệu">
                <option value="">Tất cả nhóm</option>
                <option value="Pesticide">Thuốc BVTV</option>
                <option value="Fertilize">Phân bón</option>
                <option value="Care">Vật liệu khác</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-responsive-card material-usage-table">
                <thead>
                    <tr>
                        <th>Ngày dùng</th>
                        <th>Nhóm</th>
                        <th>Tên vật liệu</th>
                        <th>Lượng dùng</th>
                        <th>Công nhân thực hiện</th>
                        <th>Thời gian cách ly</th>
                        @if (Model.CanEdit)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var end = MaterialUsageService.WithdrawalEnd(r);
                        var badgeClass = r.Kind == "Pesticide" ? "bg-warning" : r.Kind == "Fertilize" ? "bg-success" : "bg-secondary";
                        var kindLabel = r.Kind == "Pesticide" ? "Thuốc BVTV" : r.Kind == "Fertilize" ? "Phân bón" : "Vật liệu khác";
                        <tr data-list-row data-status="@r.Kind" data-search="@r.ProductName @r.PerformedBy @r.QuantityText">
                            <td data-label="Ngày dùng">@(r.Date?.Year >= 2 ? r.Date.Value.ToString("dd/MM/yyyy") : "Chưa ghi ngày dùng")</td>
                            <td data-label="Nhóm">
                                <span class="badge @badgeClass">@kindLabel</span>
                                @if (r.IsLegacy)
                                {
                                    <small class="d-block text-muted">Sổ cũ</small>
                                }
                            </td>
                            <td data-label="Tên vật liệu"><strong>@(string.IsNullOrWhiteSpace(r.ProductName) ? "Chưa xác định sản phẩm" : r.ProductName)</strong></td>
                            <td data-label="Lượng dùng">@(string.IsNullOrWhiteSpace(r.QuantityText) ? "Chưa ghi lượng dùng" : r.QuantityText)</td>
                            <td data-label="Công nhân">@(string.IsNullOrWhiteSpace(r.PerformedBy) ? "Chưa ghi người thực hiện" : r.PerformedBy)</td>
                            <td data-label="Thời gian cách ly">
                                @if (r.WithdrawalDays is >= 0 and <= 36500)
                                {
                                    <strong>@r.WithdrawalDays ngày</strong>
                                    @if (end.HasValue)
                                    {
                                        <small class="d-block">Mốc theo ngày đã ghi: @end.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                    else
                                    {
                                        <small class="d-block text-warning">Chưa tính được mốc; kiểm tra ngày dùng.</small>
                                    }
                                }
                                else
                                {
                                    <span>Chưa ghi nhận</span>
                                }
                            </td>
                            @if (Model.CanEdit)
                            {
                                <td>
                                    @if (r.JournalEntryId.HasValue)
                                    {
                                        <a asp-controller="CropJournal" asp-action="Edit" asp-route-id="@r.JournalEntryId">Xem / sửa</a>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Dữ liệu sổ cũ</small>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div data-list-empty class="filter-empty" hidden>Không có lần dùng phù hợp.</div>
        <div class="list-footer">
            <span data-list-count></span>
            <div class="list-pagination">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button>
                <span data-list-page></span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button>
            </div>
        </div>
    }
</section>

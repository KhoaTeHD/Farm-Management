@model Farm_Management.Models.ViewModels.MaterialUsageTableViewModel
@using Farm_Management.Services
@{var rows=Model.Rows.OrderByDescending(r=>r.Date).ThenBy(r=>r.Kind).ToList();}
<section class="card mb-4 material-usage-section" data-list data-page-size="15" id="material-usage">
    <div class="card-header"><h2 class="mb-0">Thuốc và phân bón đã dùng</h2><p class="mb-0 mt-2">@(Model.IsSnapshot?"Thông tin của từng lần sử dụng trong bản truy xuất đã lưu; không lấy tên hay người thực hiện mới để thay nội dung cũ.":"Mỗi dòng là một lần sử dụng thực tế, không phải danh sách vật tư đã nhập kho.")</p></div>
    @if(Model.OlderLegacySnapshot){<div class="card-body"><p class="text-warning mb-0">Bản truy xuất cũ chưa lưu bảng chi tiết thuốc/phân từ sổ cũ. Xem nguyên văn sổ cũ bên dưới; muốn bổ sung phải đối chiếu và cập nhật bản truy xuất. Không tự điền từ danh mục hiện tại vào bản lịch sử.</p></div>}
    @if(!rows.Any()){<div class="card-body"><p class="mb-0">Chưa có lần dùng thuốc/phân được ghi trong @(Model.IsSnapshot?"bảng chi tiết của bản lưu này":"sổ mùa vụ này"). Thiếu ghi chép không có nghĩa là chưa từng sử dụng.</p></div>}
    else{
        <div class="list-toolbar"><input type="search" data-list-search class="form-control" aria-label="Tìm thuốc hoặc phân bón đã dùng" placeholder="Tìm tên sản phẩm hoặc người thực hiện…"/><select data-list-status class="form-select list-filter" aria-label="Lọc thuốc và phân bón"><option value="">Thuốc và phân bón</option><option value="Pesticide">Chỉ thuốc BVTV</option><option value="Fertilize">Chỉ phân bón</option></select></div>
        <div class="table-responsive"><table class="table table-responsive-card material-usage-table"><thead><tr><th>Ngày dùng</th><th>Nhóm</th><th>Tên sản phẩm đã dùng</th><th>Lượng dùng</th><th>Người thực hiện</th><th>Thời gian cách ly</th>@if(Model.CanEdit){<th></th>}</tr></thead><tbody>
        @foreach(var r in rows){var end=MaterialUsageService.WithdrawalEnd(r);<tr data-list-row data-status="@r.Kind" data-search="@r.ProductName @r.PerformedBy @r.QuantityText"><td data-label="Ngày dùng">@(r.Date?.Year>=2?r.Date.Value.ToString("dd/MM/yyyy"):"Chưa ghi ngày dùng")</td><td data-label="Nhóm"><span class="badge @(r.Kind=="Pesticide"?"bg-warning":"bg-success")">@(r.Kind=="Pesticide"?"Thuốc BVTV":"Phân bón")</span>@if(r.IsLegacy){<small class="d-block text-muted">Sổ cũ</small>}</td><td data-label="Tên sản phẩm"><strong>@(string.IsNullOrWhiteSpace(r.ProductName)?"Chưa xác định sản phẩm":r.ProductName)</strong></td><td data-label="Lượng dùng">@(string.IsNullOrWhiteSpace(r.QuantityText)?"Chưa ghi lượng dùng":r.QuantityText)</td><td data-label="Người thực hiện">@(string.IsNullOrWhiteSpace(r.PerformedBy)?"Chưa ghi người thực hiện":r.PerformedBy)</td><td data-label="Thời gian cách ly">@if(r.WithdrawalDays is >=0 and <=36500){<strong>@r.WithdrawalDays ngày</strong>@if(end.HasValue){<small class="d-block">Mốc theo ngày đã ghi: @end.Value.ToString("dd/MM/yyyy")</small>}else{<small class="d-block text-warning">Chưa tính được mốc; kiểm tra ngày dùng.</small>}}else{<span>Chưa ghi nhận</span>}</td>@if(Model.CanEdit){<td>@if(r.JournalEntryId.HasValue){<a asp-controller="CropJournal" asp-action="Edit" asp-route-id="@r.JournalEntryId">Xem / sửa lần dùng</a>}else{<small class="text-muted">Dữ liệu sổ cũ</small>}</td>}</tr>}
        </tbody></table></div><div data-list-empty class="filter-empty" hidden>Không có lần dùng phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>
    }
    <div class="card-body border-top"><p class="form-text mb-0">Cách ly được hiển thị theo số ngày đã ghi, không tự coi dữ liệu thiếu là 0 ngày. Với phân bón chưa ghi thông tin cách ly, cần đối chiếu nhãn/hướng dẫn của sản phẩm. @if(rows.Any(r=>r.IsLegacy) && !Model.IsSnapshot){<span>Tên sản phẩm/người làm từ sổ cũ được đối chiếu theo danh mục hiện có.</span>}</p></div>
</section>

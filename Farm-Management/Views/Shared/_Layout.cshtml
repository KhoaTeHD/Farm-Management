@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "is-active" : "";
    var culture = new System.Globalization.CultureInfo("vi-VN");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173d32" />
    <title>@ViewData["Title"] · Farm Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["LoadMap"] as bool? == true)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    <partial name="_Icons" />
    <div class="sidebar-backdrop" data-close-menu></div>
    <aside class="app-sidebar" id="app-navigation" aria-label="Điều hướng chính">
        <button type="button" class="mobile-menu-close" data-close-menu aria-label="Đóng menu">×</button>
        <a asp-controller="Home" asp-action="Index" class="brand">
            <span class="brand-mark"><svg class="icon"><use href="#i-leaf" /></svg></span>
            <span>Farm<span class="brand-light"> Management</span><small>KHÔNG GIAN NÔNG TRẠI</small></span>
        </a>
        <div class="workspace-label"><span class="status-dot"></span> Quản lý trang trại</div>
        <nav class="side-nav">
            <span class="nav-section-label">KHÔNG GIAN LÀM VIỆC</span>
            <a asp-controller="Home" asp-action="Index" class="@Active("Home", "Index")"><svg class="icon"><use href="#i-grid" /></svg>Tổng quan</a>
            <a asp-controller="Areas" asp-action="Index" class="@Active("Areas")"><svg class="icon"><use href="#i-map" /></svg>Vùng trồng</a>
            <a asp-controller="Workers" asp-action="Index" class="@Active("Workers")"><svg class="icon"><use href="#i-users" /></svg>Công nhân</a>
            <span class="nav-section-label">CÂY TRỒNG</span>
            <a asp-controller="Plants" asp-action="Index" class="@(controller is "Plants" or "CropJournal" or "CarePlans" ? "is-active" : "")"><svg class="icon"><use href="#i-leaf"/></svg>Theo dõi cây trồng</a>
            <a asp-controller="PlantTypes" asp-action="Index" class="@Active("PlantTypes")"><svg class="icon"><use href="#i-list"/></svg>Loại cây</a>
            <a asp-controller="Seeds" asp-action="Index" class="@Active("Seeds")"><svg class="icon"><use href="#i-leaf"/></svg>Giống cây</a>
            <a asp-controller="FarmRecords" asp-action="Index" class="@Active("FarmRecords")"><svg class="icon"><use href="#i-list"/></svg>Vật tư & kiểm nghiệm</a><a asp-controller="HarvestTrace" asp-action="Index" class="@Active("HarvestTrace")"><svg class="icon"><use href="#i-leaf"/></svg>Truy xuất thu hoạch</a><a asp-controller="RecordHistory" asp-action="Index" class="@Active("RecordHistory")"><svg class="icon"><use href="#i-clock"/></svg>Lịch sử & lưu hồ sơ</a><span class="nav-section-label">CHẤM CÔNG</span>
            <a asp-controller="Attendance" asp-action="Calendar" class="@Active("Attendance", "Calendar")"><svg class="icon"><use href="#i-calendar" /></svg>Lịch chấm công</a>
            <a asp-controller="Attendance" asp-action="Index" class="@(controller == "Attendance" && action != "Calendar" ? "is-active" : "")"><svg class="icon"><use href="#i-list" /></svg>Chấm công theo ngày</a>
            <span class="nav-section-label">TIỀN LƯƠNG</span>
            <a asp-controller="Payroll" asp-action="Index" class="@Active("Payroll")"><svg class="icon"><use href="#i-list" /></svg>Bảng lương tháng</a>
            <a asp-controller="Advances" asp-action="Index" class="@Active("Advances")"><svg class="icon"><use href="#i-list"/></svg>Tạm ứng công nhân</a>
        </nav>
        <div class="sidebar-bottom">
            <div class="sidebar-note"><svg class="icon"><use href="#i-leaf" /></svg><strong>Cùng chăm một mùa xanh</strong><p>Ghi chép rõ ràng. Quản lý nhẹ nhàng.</p></div>
            <a asp-controller="Home" asp-action="Privacy"><svg class="icon"><use href="#i-info" /></svg>Thông tin ứng dụng</a>
            <small>Farm Management · 2026</small>
        </div>
    </aside>
    <div class="app-workspace">
        <header class="app-topbar">
            <button type="button" class="icon-button mobile-menu-toggle" aria-label="Mở menu điều hướng" aria-controls="app-navigation" aria-expanded="false"><svg class="icon"><use href="#i-menu" /></svg></button>
            <div class="breadcrumb-label">Không gian làm việc <span>/</span> <strong>@ViewData["Title"]</strong></div>
            <div class="topbar-date"><svg class="icon"><use href="#i-calendar" /></svg>@DateTime.Today.ToString("dddd, dd/MM/yyyy", culture)</div>
        </header>
        <main id="main-content" class="app-content" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status"><svg class="icon"><use href="#i-check" /></svg><span>@success</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert"><svg class="icon"><use href="#i-info" /></svg><span>@error</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button></div>
            }
            @RenderBody()
        </main>
        <footer class="app-footer"><span>Farm Management</span><span>Chăm từng vùng đất, vững từng mùa vụ.</span></footer>
    </div>
    <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="true"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewData["LoadMap"] as bool? == true)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

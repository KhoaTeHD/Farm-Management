@model ErrorViewModel
@{ ViewData["Title"] = "Chưa thể xử lý yêu cầu"; }
<section class="card"><div class="empty-state"><svg class="icon empty-icon"><use href="#i-info" /></svg><h1>Chưa thể hoàn thành thao tác.</h1><p>Đã có lỗi khi xử lý yêu cầu. Hãy tải lại trang hoặc quay về tổng quan để thử lại.</p>@if(Model.ShowRequestId){<p class="small text-muted">Mã tra cứu: @Model.RequestId</p>}<a asp-controller="Home" asp-action="Index" class="btn btn-farm">Về tổng quan</a></div></section>

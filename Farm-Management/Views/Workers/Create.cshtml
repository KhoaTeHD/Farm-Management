@model Farm_Management.Models.ViewModels.WorkerForm
@{ ViewData["Title"] = "Thêm công nhân"; }
<div class="page-header"><div><p class="eyebrow">ĐỘI NGŨ TRANG TRẠI</p><h1>Thêm công nhân</h1><p class="page-description">Thông tin chính xác giúp việc chấm công mỗi ngày dễ dàng hơn.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách công nhân</a></div>
<div class="form-layout"><form asp-action="Create" class="card form-main" data-save-form><div class="px-4 pt-4"><div asp-validation-summary="ModelOnly"></div></div><input type="hidden" asp-for="Id" /><partial name="_Fields" model="Model" /><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm"><svg class="icon"><use href="#i-check" /></svg>Lưu công nhân</button></div></form><aside class="form-aside"><svg class="icon mb-3"><use href="#i-info" /></svg><h3>Một hồ sơ, dùng lâu dài.</h3><p>Các trường có dấu * cần được điền đầy đủ.</p><ul><li>Dùng mã ngắn, dễ nhớ cho từng công nhân.</li><li>Mức lương ngày dùng để ước tính tiền công theo 8 giờ.</li><li>Khi công nhân nghỉ, đổi trạng thái để giữ lại lịch sử làm việc.</li></ul></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model Farm_Management.Models.Worker
@{ ViewData["Title"] = "Xóa công nhân"; }
<partial name="_DeletePanel" model='new Farm_Management.Models.ViewModels.DeleteConfirmationViewModel { Id = Model.Id, Title = "Xóa công nhân này?", Description = "Thông tin hồ sơ sẽ bị xóa khỏi danh sách công nhân.", Notice = "Công nhân có lịch sử chấm công hoặc canh tác sẽ không được phép xóa. Bạn có thể chọn trạng thái Đã nghỉ việc để giữ lịch sử.", Items = new() { ("Họ tên", Model.FullName ?? "Chưa có tên"), ("Mã công nhân", Model.Code ?? "—"), ("Liên hệ", Model.Phone ?? "Chưa cập nhật"), ("Lương ngày", (Model.DailySalary?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "Chưa cập nhật") + " đ") } }' />

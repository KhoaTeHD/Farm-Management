@model Farm_Management.Models.ViewModels.WorkerForm
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-users" /></svg>Thông tin công nhân</h2><div class="row g-3"><div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" placeholder="VD: CN001" autocomplete="off" /><span asp-validation-for="Code"></span><p class="form-text">Mã riêng, không trùng công nhân khác.</p></div><div class="col-md-8"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" placeholder="VD: 0901 234 567" autocomplete="tel" /><span asp-validation-for="Phone"></span></div><div class="col-md-6"><label asp-for="HireDate" class="form-label"></label><input asp-for="HireDate" class="form-control" type="date" /><span asp-validation-for="HireDate"></span></div></div></div>
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-clock" /></svg>Lương & trạng thái</h2><div class="row g-3"><div class="col-md-6"><label asp-for="DailySalary" class="form-label"></label><div class="input-group"><input asp-for="DailySalary" class="form-control" type="number" min="1" max="10000000" step="0.01" inputmode="decimal" placeholder="200000" data-salary-input /><span class="input-group-text">đ / ngày</span></div><span asp-validation-for="DailySalary"></span><p class="form-text">Ngày công tiêu chuẩn: 8 giờ. <span data-hourly-preview></span></p></div><div class="col-md-6"><label asp-for="IsActive" class="form-label"></label><select asp-for="IsActive" class="form-select"><option value="">-- Chọn trạng thái --</option><option value="true">Đang làm việc</option><option value="false">Đã nghỉ việc</option></select><span asp-validation-for="IsActive"></span><p class="form-text">Chỉ công nhân đang làm mới được chấm công mới.</p></div></div></div>

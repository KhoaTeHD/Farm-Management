@model Farm_Management.Models.Worker
@{ ViewData["Title"] = "Hồ sơ công nhân"; }
<div class="page-header"><div><p class="eyebrow">ĐỘI NGŨ TRANG TRẠI</p><h1>@(Model.FullName ?? "Hồ sơ công nhân")</h1><p class="page-description">@(Model.Code ?? "Chưa có mã công nhân") · @ViewBag.AttendanceCount bản ghi chấm công</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-farm"><svg class="icon"><use href="#i-edit" /></svg>Sửa hồ sơ</a></div></div>
<div class="card"><div class="card-header">Thông tin công nhân</div><div class="card-body"><dl class="definition-grid"><div><dt>Họ và tên</dt><dd>@(Model.FullName ?? "Chưa cập nhật")</dd></div><div><dt>Mã công nhân</dt><dd>@(Model.Code ?? "Chưa cập nhật")</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.Phone ?? "Chưa cập nhật")</dd></div><div><dt>Ngày vào làm</dt><dd>@(Model.HireDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div><div><dt>Lương ngày (8 giờ)</dt><dd>@(Model.DailySalary?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "Chưa cập nhật") đ</dd></div><div><dt>Trạng thái</dt><dd><span class="badge @(Model.IsActive == true ? "bg-success" : "bg-secondary")">@(Model.IsActive == true ? "Đang làm việc" : Model.IsActive == false ? "Đã nghỉ việc" : "Chưa có trạng thái")</span></dd></div><div><dt>Ngày tạo hồ sơ</dt><dd>@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</dd></div></dl></div></div>

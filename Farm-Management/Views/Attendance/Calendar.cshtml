@model Farm_Management.Models.ViewModels.AttendanceCalendarViewModel
@{
    ViewData["Title"] = "Lịch chấm công";
    var culture = new System.Globalization.CultureInfo("vi-VN");
    var start = new DateTime(Model.Year, Model.Month, 1);
    var prev = start.AddMonths(-1);
    var next = start.AddMonths(1);
    var valid = Model.Logs.Values.Where(l => AttendanceRules.IsValidHours(l.HoursWorked)).ToList();
    var fullDays = valid.Count(l => AttendanceRules.Classify(l.HoursWorked) == "FullDay") + 0.5m * valid.Count(l => AttendanceRules.Classify(l.HoursWorked) == "HalfDay");
    var oddHours = valid.Where(l => AttendanceRules.Classify(l.HoursWorked) == "OddHours").Sum(l => l.HoursWorked!.Value);
}
<div class="page-header"><div><p class="eyebrow">GIỜ LÀM & NGÀY CÔNG</p><h1>Lịch chấm công</h1><p class="page-description">Nhìn trọn tháng làm việc. Nhập giờ ngay trên ô, tự động lưu khi chuyển sang ô khác.</p></div><a asp-action="Create" class="btn btn-farm"><svg class="icon"><use href="#i-plus" /></svg>Thêm chấm công</a></div>
<div class="day-navigation"><div class="list-subnav"><a asp-action="Index">Theo ngày</a><a asp-action="Calendar" class="active">Lịch tháng</a><a asp-action="Index" asp-route-missingDate="true">Thiếu ngày</a></div><form method="get" class="calendar-controls"><label class="visually-hidden" for="calendar-month">Tháng</label><select id="calendar-month" name="month" class="form-select">@for(var m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Month)">Tháng @m</option>}</select><label class="visually-hidden" for="calendar-year">Năm</label><input id="calendar-year" type="number" name="year" class="form-control" value="@Model.Year" min="2" max="9998" aria-label="Năm chấm công" /><button class="btn btn-outline-farm" type="submit">Xem tháng</button></form></div>
@if(ViewBag.DataWarning != null){<div class="alert alert-warning" role="status">@ViewBag.DataWarning</div>}
@if(ViewBag.PayrollLocked == true){<div class="alert alert-info">Tháng này đã chốt lương nên các ô chấm công được khóa. <a asp-controller="Payroll" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Xem / mở lại bảng lương</a></div>}
@Html.AntiForgeryToken()
@if(!Model.Workers.Any()) {<section class="card"><div class="empty-state"><svg class="icon empty-icon"><use href="#i-calendar" /></svg><h3>Chưa có công nhân cho tháng này</h3><p>Thêm công nhân đang làm việc để bắt đầu ghi nhận giờ trên lịch tháng.</p><a asp-controller="Workers" asp-action="Create" class="btn btn-farm">Thêm công nhân</a></div></section>}
else {
<section class="card">
    <div class="list-toolbar"><div class="d-flex gap-2 align-items-center"><a asp-action="Calendar" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="btn btn-sm btn-outline-secondary" aria-label="Tháng trước">←</a><h2 class="mb-0 px-2">Tháng @Model.Month <span class="text-muted fw-normal">/ @Model.Year</span></h2><a asp-action="Calendar" asp-route-year="@next.Year" asp-route-month="@next.Month" class="btn btn-sm btn-outline-secondary" aria-label="Tháng sau">→</a><a asp-action="Calendar" class="btn btn-sm btn-outline-farm">Hiện tại</a></div><div class="search-field" style="max-width:240px"><svg class="icon"><use href="#i-search" /></svg><input type="search" id="calendar-search" class="form-control" placeholder="Tìm công nhân…" aria-label="Tìm công nhân trên lịch" /></div></div>
    <div class="px-4 py-3 d-flex justify-content-between align-items-center gap-3 flex-wrap"><div class="calendar-legend"><span><i class="legend-dot legend-full"></i>1 công: từ 8 giờ</span><span><i class="legend-dot legend-half"></i>0,5 công: 4 giờ</span><span><i class="legend-dot legend-odd"></i>Giờ lẻ: còn lại dưới 8 giờ</span></div><span class="keyboard-hint"><kbd>Tab</kbd> chuyển ô · <kbd>Enter</kbd> lưu · 0 hoặc bỏ trống để xóa</span></div>
    <div class="calendar-scroll" tabindex="0" role="region" aria-label="Bảng chấm công tháng, có thể cuộn ngang"><table class="table attendance-calendar" data-save-url="@Url.Action("SaveCell")"><thead><tr><th class="sticky-col" scope="col">Công nhân</th>@for(var day=1;day<=Model.DaysInMonth;day++){var date=new DateTime(Model.Year,Model.Month,day);<th scope="col" class="@(date==DateTime.Today ? "bg-today" : "")"><div>@day</div><small>@date.ToString("ddd",culture)</small></th>}<th scope="col" class="calendar-total">Tổng công</th></tr></thead><tbody>
    @foreach(var worker in Model.Workers){var summary=Model.GetWorkerSummary(worker.Id);<tr data-calendar-worker data-search="@worker.FullName @worker.Code"><th scope="row" class="sticky-col"><div class="worker-name" title="@worker.FullName">@(worker.FullName ?? "Chưa có tên")</div><div class="worker-code">@(worker.Code ?? "Chưa có mã") @(worker.IsActive == true ? "" : "· Đã ngừng làm việc")</div></th>@for(var day=1;day<=Model.DaysInMonth;day++){var date=new DateTime(Model.Year,Model.Month,day);var hours=Model.GetHours(worker.Id,day);var kind=Model.GetWorkType(worker.Id,day);var duplicate=Model.DuplicateCells.Contains((worker.Id,day));var disabled=ViewBag.PayrollLocked == true || duplicate || (worker.IsActive != true && !Model.Logs.ContainsKey((worker.Id,day)));var css=kind=="FullDay"?"cell-full":kind=="HalfDay"?"cell-half":kind=="OddHours"?"cell-odd":hours.HasValue?"cell-invalid":"";var value=hours?.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture);<td class="@(date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "bg-weekend-cell" : "")" style="position:relative"><input type="number" class="form-control hours-cell @css" data-worker-id="@worker.Id" data-date="@date.ToString("yyyy-MM-dd")" value="@value" data-saved-hours="@value" disabled="@disabled" min="0" max="24" step="0.5" inputmode="decimal" placeholder="@(duplicate?"!":"·")" aria-label="@(worker.FullName), @date.ToString("dd/MM/yyyy")" title="@(duplicate ? "Bị trùng bản ghi, sửa trong danh sách theo ngày" : worker.FullName + " · " + date.ToString("dd/MM/yyyy"))" /><span class="save-indicator" aria-hidden="true">Lưu…</span></td>}<td class="calendar-total"><strong class="worker-total-days">@summary.TotalDays.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</strong><small class="d-block text-muted"><span class="worker-odd-hours">@summary.OddHours.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span> giờ lẻ</small></td></tr>}
    </tbody></table></div><div id="calendar-no-results" class="filter-empty" hidden>Không tìm thấy công nhân phù hợp.</div><div class="calendar-summary"><span>Tổng toàn bộ tháng · @Model.Workers.Count người</span><span>Ngày công <strong><span id="calendar-total-days">@fullDays.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span> công</strong></span><span>Giờ lẻ <strong><span id="calendar-odd-hours">@oddHours.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span> giờ</strong></span><span id="calendar-save-status" role="status" aria-live="polite">Đã đồng bộ</span></div>
</section>
<div class="form-text mt-3">Dữ liệu thiếu hoặc trùng không được tính vào tổng. <a asp-action="Index" asp-route-date="@start.ToString("yyyy-MM-dd")">Mở danh sách theo ngày để kiểm tra và điều chỉnh.</a></div>
}
@section Scripts { <script src="~/js/attendance-calendar.js" asp-append-version="true"></script> }

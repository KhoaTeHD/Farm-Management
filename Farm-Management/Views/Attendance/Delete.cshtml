@model Farm_Management.Models.AttendanceLog
@{ ViewData["Title"] = "Xóa chấm công"; }
@if(ViewBag.PayrollLocked == true){<div class="alert alert-warning">Tháng này đã chốt lương. Mở lại bảng lương trước khi xóa chấm công. <a asp-controller="Payroll" asp-action="Index" asp-route-year="@Model.Date?.Year" asp-route-month="@Model.Date?.Month">Xem bảng lương</a></div>}
<partial name="_DeletePanel" model='new Farm_Management.Models.ViewModels.DeleteConfirmationViewModel { Id = Model.Id, CanDelete = ViewBag.PayrollLocked != true, Date = Model.Date, Title = "Xóa bản ghi chấm công?", Description = "Số giờ của bản ghi này sẽ không còn được tính trong tổng công theo ngày và tháng.", Notice = "Nếu chỉ nhập nhầm số giờ, bạn có thể quay lại và chọn Sửa để giữ bản ghi.", Items = new() { ("Công nhân", Model.Worker?.FullName ?? "Thiếu công nhân"), ("Ngày làm", Model.Date?.ToString("dd/MM/yyyy") ?? "Thiếu ngày"), ("Giờ làm", (Model.HoursWorked?.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "—") + " giờ"), ("Ghi chú", Model.Notes ?? "—") } }' />

@model Farm_Management.Models.ViewModels.AttendanceLogForm
@{ ViewData["Title"] = "Sửa chấm công"; }
<div class="page-header"><div><p class="eyebrow">GIỜ LÀM & NGÀY CÔNG</p><h1>Sửa chấm công</h1><p class="page-description">Ghi nhận đúng người, đúng ngày và đúng số giờ làm việc.</p></div><a asp-action="Index" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">← Danh sách chấm công</a></div>
<div class="form-layout"><form asp-action="Edit" class="card form-main" data-save-form><div class="px-4 pt-4"><div asp-validation-summary="ModelOnly"></div></div><input type="hidden" asp-for="Id" /><partial name="_Fields" model="Model" /><div class="form-actions"><a asp-action="Index" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm"><svg class="icon"><use href="#i-check" /></svg>Lưu thay đổi</button></div></form><aside class="form-aside"><svg class="icon mb-3"><use href="#i-clock" /></svg><h3>Cách tính ngày công</h3><ul><li>Từ 8 giờ trở lên: 1 ngày công.</li><li>Đúng 4 giờ: 0,5 ngày công.</li><li>Số giờ còn lại dưới 8 giờ: tính theo giờ lẻ.</li><li>Lương giờ = lương ngày ÷ 8.</li></ul><p class="mt-3 mb-0">Mỗi công nhân chỉ có một bản ghi trong một ngày.</p></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/attendance-form.js" asp-append-version="true"></script> }

@model Farm_Management.Models.AttendanceLog
@{ ViewData["Title"] = "Chi tiết chấm công"; }
<div class="page-header"><div><p class="eyebrow">GIỜ LÀM & NGÀY CÔNG</p><h1>Chi tiết chấm công</h1><p class="page-description">@(Model.Worker?.FullName ?? "Cần bổ sung công nhân") · @(Model.Date?.ToString("dd/MM/yyyy") ?? "Thiếu ngày")</p></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-farm">Sửa chấm công</a></div>
<div class="card"><div class="card-body"><dl class="definition-grid"><div><dt>Công nhân</dt><dd>@(Model.Worker?.FullName ?? "Chưa có công nhân")</dd></div><div><dt>Mã công nhân</dt><dd>@(Model.Worker?.Code ?? "Chưa có mã")</dd></div><div><dt>Ngày làm</dt><dd>@(Model.Date?.ToString("dd/MM/yyyy") ?? "Chưa có ngày")</dd></div><div><dt>Giờ làm</dt><dd>@(Model.HoursWorked?.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "Chưa có số giờ")</dd></div><div><dt>Ghi chú</dt><dd>@(Model.Notes ?? "—")</dd></div></dl></div><div class="card-footer"><a asp-action="Index" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">← Danh sách theo ngày</a></div></div>

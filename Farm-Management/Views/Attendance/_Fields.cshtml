@model Farm_Management.Models.ViewModels.AttendanceLogForm
@if(ViewBag.PayrollLocked == true){<div class="alert alert-warning m-4 mb-0">Tháng của bản ghi đã chốt lương. Cần mở lại bảng lương trước khi lưu thay đổi. <a asp-controller="Payroll" asp-action="Index" asp-route-year="@Model.Date?.Year" asp-route-month="@Model.Date?.Month">Xem bảng lương</a></div>}
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-calendar" /></svg>Thông tin chấm công</h2><div class="row g-3"><div class="col-md-7"><label asp-for="WorkerId" class="form-label"></label><select asp-for="WorkerId" asp-items="ViewBag.WorkerId" class="form-select"><option value="">-- Chọn công nhân --</option></select><span asp-validation-for="WorkerId"></span></div><div class="col-md-5"><label asp-for="Date" class="form-label"></label><input asp-for="Date" class="form-control" type="date" min="0002-01-01" max="9998-12-31" /><span asp-validation-for="Date"></span></div><div class="col-md-7"><label asp-for="HoursWorked" for="hoursInput" class="form-label"></label><div class="input-group"><input asp-for="HoursWorked" class="form-control" type="number" step="0.5" min="0" max="24" inputmode="decimal" placeholder="8" id="hoursInput" /><span class="input-group-text">giờ</span></div><span asp-validation-for="HoursWorked"></span><p class="form-text">Nhập từ 0 đến 24 giờ, theo bước 0,5 giờ.</p></div><div class="col-md-5"><span class="form-label">Phân loại tự động</span><div class="form-control bg-light" id="workTypePreview" aria-live="polite">Chưa có số giờ</div></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="500" placeholder="Công việc trong ngày, ca làm hoặc thông tin cần lưu ý…"></textarea><span asp-validation-for="Notes"></span></div></div></div>
<div class="form-section"><div class="d-flex justify-content-between align-items-center gap-3"><div><span class="form-label mb-1">Tiền công ước tính</span><p class="form-text mb-0">Dựa trên mức lương ngày hiện tại. Chưa phải bảng lương đã chốt.</p></div><strong class="text-success" id="salaryPreview" aria-live="polite">Chưa đủ thông tin</strong></div></div>
<script id="worker-salaries" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)ViewBag.WorkerSalaries))</script>

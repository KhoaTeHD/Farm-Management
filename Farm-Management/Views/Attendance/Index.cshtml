@model IEnumerable<Farm_Management.Models.AttendanceLog>
@{
    ViewData["Title"] = "Chấm công theo ngày";
    var day = (DateTime)ViewBag.SelectedDate;
    var missingDate = ViewBag.MissingDate == true;
    var valid = (List<Farm_Management.Models.AttendanceLog>)ViewBag.ValidLogs;
    var available = (List<Farm_Management.Models.Worker>)ViewBag.AvailableWorkers;
    var days = valid.Count(l => AttendanceRules.Classify(l.HoursWorked) == "FullDay") + valid.Count(l => AttendanceRules.Classify(l.HoursWorked) == "HalfDay") * 0.5m;
    var odd = valid.Where(l => AttendanceRules.Classify(l.HoursWorked) == "OddHours").Sum(l => l.HoursWorked!.Value);
}
<div class="page-header"><div><p class="eyebrow">GIỜ LÀM & NGÀY CÔNG</p><h1>Chấm công theo ngày</h1><p class="page-description">Chọn công nhân, nhập số giờ và lưu cùng lúc cho cả đội.</p></div><a asp-action="Create" asp-route-date="@day.ToString("yyyy-MM-dd")" class="btn btn-farm"><svg class="icon"><use href="#i-plus" /></svg>Thêm chấm công</a></div>
<div class="day-navigation"><div class="list-subnav"><a asp-action="Index" asp-route-date="@day.ToString("yyyy-MM-dd")" class="@(!missingDate ? "active" : "")">Theo ngày</a><a asp-action="Calendar" asp-route-year="@day.Year" asp-route-month="@day.Month">Lịch tháng</a><a asp-action="Index" asp-route-missingDate="true" class="@(missingDate ? "active" : "")">Thiếu ngày</a></div>@if(!missingDate){<div class="day-picker"><a asp-action="Index" asp-route-date="@day.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" aria-label="Ngày trước">←</a><input type="date" id="dateSelector" class="form-control" value="@day.ToString("yyyy-MM-dd")" aria-label="Ngày chấm công" min="0002-01-01" max="9998-12-31" /><a asp-action="Index" asp-route-date="@day.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" aria-label="Ngày tiếp theo">→</a><a asp-action="Index" class="btn btn-outline-farm" style="width:auto">Hôm nay</a></div>}</div>
@if(missingDate){<div class="alert alert-warning" role="status">Các bản ghi chưa có ngày được hiển thị ở đây. Chọn Sửa để bổ sung thông tin.</div>}
@if(ViewBag.DataWarning != null){<div class="alert alert-warning" role="status">@ViewBag.DataWarning</div>}
@if(ViewBag.PayrollLocked == true && !missingDate){<div class="alert alert-info">Tháng này đã chốt lương. Chấm công được khóa để giữ đúng bảng lương. <a asp-controller="Payroll" asp-action="Index" asp-route-year="@day.Year" asp-route-month="@day.Month">Xem / mở lại bảng lương</a></div>}
@if(available.Any()){
<section class="card mb-4"><div class="card-header"><div class="section-header mb-0"><div><h2>Chưa chấm công <span class="pill ms-2">@available.Count người</span></h2><span class="form-text">@day.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span></div><span class="keyboard-hint">Mặc định 8 giờ / người</span></div></div>
<form asp-action="MarkAttendance" method="post" data-save-form id="batch-attendance"><input type="hidden" name="date" value="@day.ToString("yyyy-MM-dd")" /><div class="table-responsive"><table class="table attendance-choice-table"><thead><tr><th style="width:42px"><input type="checkbox" id="selectAll" class="form-check-input" aria-label="Chọn tất cả công nhân" /></th><th>Công nhân</th><th style="width:180px">Số giờ làm</th><th>Ghi chú</th></tr></thead><tbody>
@foreach(var worker in available){<tr class="worker-row"><td><input type="checkbox" name="workerIds" value="@worker.Id" class="form-check-input worker-checkbox" aria-label="Chọn @(worker.FullName)" /></td><td><strong>@(worker.FullName ?? "Chưa có tên")</strong><small class="d-block text-muted">@(worker.Code ?? "Chưa có mã")</small></td><td><div class="input-group input-group-sm"><input type="number" name="hours" class="form-control hours-input" step="0.5" min="0" max="24" value="8" inputmode="decimal" required disabled aria-label="Số giờ của @(worker.FullName)" /><span class="input-group-text work-type-badge">1 công</span></div></td><td><input type="text" name="notes" class="form-control notes-input" maxlength="500" placeholder="Công việc, ca làm…" disabled aria-label="Ghi chú cho @(worker.FullName)" /></td></tr>}
</tbody></table></div><div class="batch-actions"><small><strong id="selectedCount">0</strong> người được chọn · Có thể chỉnh số giờ từng người.</small><button type="submit" class="btn btn-farm" id="submitBtn" disabled><svg class="icon"><use href="#i-check" /></svg>Lưu chấm công</button></div></form></section>
}
else if(!missingDate && ViewBag.PayrollLocked != true){<div class="alert alert-info" role="status">@(Model.Any() ? "Không còn công nhân đang làm việc cần chấm công thêm cho ngày này." : "Chưa có công nhân đang làm việc để chấm công.") <a asp-controller="Workers" asp-action="Index" class="text-link">Xem công nhân →</a></div>}
<section class="card"><div class="card-header"><div class="section-header mb-0"><h2>@(missingDate ? "Bản ghi cần bổ sung ngày" : "Đã ghi nhận") <span class="pill ms-2">@Model.Count() bản ghi</span></h2>@if(!missingDate){<span class="keyboard-hint">@day.ToString("dd/MM/yyyy")</span>}</div></div>
@if(Model.Any()){<div class="table-responsive"><table class="table table-farm table-responsive-card"><thead><tr><th>Công nhân</th><th>Số giờ</th><th>Ngày công</th><th>Ghi chú</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach(var log in Model){var type=AttendanceRules.Classify(log.HoursWorked);<tr><td data-label="Công nhân"><strong>@(log.Worker?.FullName ?? "Cần bổ sung công nhân")</strong><small class="d-block text-muted">@(log.Worker?.Code ?? "Thiếu mã công nhân")</small></td><td data-label="Giờ làm">@(log.HoursWorked?.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "—") giờ</td><td data-label="Phân loại">@if(type == "FullDay"){<span class="badge bg-success">1 công</span>}else if(type == "HalfDay"){<span class="badge bg-warning">0,5 công</span>}else if(type == "OddHours"){<span class="badge bg-info">@log.HoursWorked giờ lẻ</span>}else{<span class="badge bg-danger">Cần kiểm tra số giờ</span>}</td><td data-label="Ghi chú">@(log.Notes ?? "—")</td><td data-label="" class="text-end"><div class="d-inline-flex gap-2"><a asp-action="Edit" asp-route-id="@log.Id" class="btn btn-sm btn-outline-farm" aria-label="Sửa chấm công @(log.Worker?.FullName)">Sửa</a><a asp-action="Delete" asp-route-id="@log.Id" class="btn btn-sm btn-outline-danger" aria-label="Xóa chấm công @(log.Worker?.FullName)">Xóa</a></div></td></tr>}
</tbody></table></div><div class="calendar-summary"><span>Tổng bản ghi hợp lệ <strong>@valid.Count</strong></span><span>Ngày công <strong>@days.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) công</strong></span><span>Giờ lẻ <strong>@odd.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) giờ</strong></span></div>}
else{<div class="empty-state compact"><svg class="icon empty-icon"><use href="#i-list" /></svg><h3>@(missingDate ? "Không có bản ghi thiếu ngày" : "Chưa có chấm công trong ngày này")</h3><p>@(missingDate ? "Thông tin ngày chấm công đang đầy đủ." : "Chọn công nhân ở phía trên hoặc thêm một chấm công mới.")</p></div>}
</section>
@section Scripts { <script src="~/js/attendance-day.js" asp-append-version="true"></script> }

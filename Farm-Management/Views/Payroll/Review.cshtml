@model Farm_Management.Models.ViewModels.PayrollMonthViewModel
@{ ViewData["Title"]="Kiểm tra & chốt lương"; var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<section class="card form-container-center"><div class="card-body"><p class="eyebrow">XÁC NHẬN DỮ LIỆU</p><h1>Chốt lương tháng @Model.Month.ToString("00")/@Model.Year?</h1><p class="page-description mb-4">Mức lương, ngày công và chi tiết chấm công sẽ được lưu riêng để đối chiếu sau này.</p><dl class="definition-grid"><div><dt>Công nhân tính được lương</dt><dd>@Model.ValidWorkerCount người</dd></div><div><dt>Thực lĩnh sau tạm ứng</dt><dd class="fw-bold text-success">@Model.NetTotal.ToString("N0",vi) đ</dd></div><div><dt>Lương gộp</dt><dd>@Model.Total.ToString("N0",vi) đ</dd></div><div><dt>Tạm ứng khấu trừ</dt><dd>@Model.TotalAdvances.ToString("N0",vi) đ</dd></div></dl><div class="inline-notice">Sau khi chốt, ứng dụng sẽ khóa thêm, sửa và xóa chấm công, tạm ứng trong tháng. Có thể mở lại tháng khi cần điều chỉnh; lần chốt cũ vẫn được giữ.</div>@if(!Model.CanFinalize){<div class="alert alert-warning mt-3">Bảng lương chưa đủ điều kiện chốt hoặc đã được chốt. Hãy quay lại để kiểm tra dữ liệu.</div>}</div><form asp-action="FinalizeMonth" method="post" class="form-actions" data-save-form><input type="hidden" name="Year" value="@Model.Year" /><input type="hidden" name="Month" value="@Model.Month" /><input type="hidden" name="ReviewToken" value="@Model.ReviewToken" /><a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Quay lại kiểm tra</a><button type="submit" class="btn btn-farm" disabled="@(!Model.CanFinalize)">Xác nhận chốt tháng</button></form></section>

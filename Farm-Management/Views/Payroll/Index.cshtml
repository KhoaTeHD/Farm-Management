@model Farm_Management.Models.ViewModels.PayrollMonthViewModel
@using Farm_Management.Services
@{
    ViewData["Title"] = "Bảng lương tháng";
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var saved = Model.Finalized != null;
    var closed = saved && Model.Finalized!.Status == PayrollService.Finalized;
    var bad = Model.SnapshotInvalid || Model.ConflictingRuns;
}
<div class="page-header"><div><p class="eyebrow">CÔNG SỨC ĐƯỢC GHI NHẬN</p><h1>Bảng lương tháng @Model.Month.ToString("00") / @Model.Year</h1><p class="page-description">Tổng hợp tiền công từ chấm công theo tháng. @(saved ? "Dữ liệu tại thời điểm chốt được giữ riêng." : "Bản tạm tính sử dụng mức lương ngày hiện tại của công nhân.")</p></div><div class="d-flex gap-2 flex-wrap payroll-actions"><a asp-controller="Advances" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Tạm ứng tháng</a>@if(!bad && (saved || Model.CanFinalize)){@if(!Model.IsArchive){<a asp-action="Export" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Xuất CSV</a>}<button type="button" class="btn btn-outline-secondary" data-print-payroll>In bảng lương</button>}@if(Model.CanFinalize){<a asp-action="Review" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-farm"><svg class="icon"><use href="#i-check" /></svg>Kiểm tra & chốt tháng</a>}@if(closed && !Model.IsArchive){<a asp-action="Reopen" asp-route-id="@Model.Finalized!.Id" class="btn btn-outline-farm">Mở lại tháng</a>}</div></div>
<div class="day-navigation payroll-controls"><div class="d-flex align-items-center gap-2"><span class="badge @(closed ? "bg-success" : "bg-warning")">@(Model.IsArchive ? "Bản chốt lưu trữ" : closed ? "Đã chốt" : "Tạm tính")</span>@if(saved){<small class="text-muted">Chốt lúc @(Model.Finalized!.FinalizedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thời điểm")</small>}</div><form asp-action="Index" method="get" class="calendar-controls"><label class="visually-hidden" for="payroll-month">Tháng tính lương</label><select id="payroll-month" name="month" class="form-select">@for(var m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Month)">Tháng @m</option>}</select><label class="visually-hidden" for="payroll-year">Năm tính lương</label><input id="payroll-year" type="number" name="year" min="2" max="9998" class="form-control" value="@Model.Year" /><button type="submit" class="btn btn-outline-farm">Xem bảng lương</button></form></div>
@if(saved && Model.Finalized!.CalculationVersion==1){<div class="alert alert-info">Bản chốt này được lập trước tính năng tạm ứng; số lương đã lưu được giữ nguyên, không áp thêm khoản ứng hiện tại.</div>}
@if(Model.IsArchive){<div class="alert alert-info">Đang xem bản lưu #@Model.Finalized!.Id. Mức lương, số công và tiền lương phản ánh lần chốt này. <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Về tháng hiện tại</a></div>}
@if(Model.SourceChanged){<div class="alert alert-warning" role="alert">Chấm công hoặc tạm ứng hiện tại đã khác dữ liệu khi chốt. Bảng bên dưới vẫn giữ số tiền đã lưu; hãy rà soát trước khi dùng để đối chiếu.</div>}
@if(bad){<div class="alert alert-danger" role="alert">Bảng lương lưu trữ có dữ liệu thiếu, sai hoặc trùng. Chưa thể xác nhận tổng tiền, in hoặc xuất bảng lương. Hãy kiểm tra dữ liệu hoặc mở lại tháng để tính lại.</div>}
@if(!saved && Model.Issues.Any()){
<section class="card mb-4"><div class="card-header"><h2 class="mb-0">Cần kiểm tra trước khi chốt <span class="badge bg-warning ms-2">@Model.Issues.Count vấn đề</span></h2></div><div class="card-body"><p class="text-muted">Không tính tiền một phần cho công nhân có dữ liệu lỗi. Hoàn thiện dữ liệu dưới đây rồi tải lại bảng lương.</p><ul class="payroll-issues">@foreach(var issue in Model.Issues.Take(50)){<li><span>@issue.Message</span><span class="d-inline-flex gap-3">@if(issue.Advance){<a asp-controller="Advances" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Kiểm tra tạm ứng</a><a asp-controller="Advances" asp-action="Index" asp-route-incomplete="true">Phiếu cần bổ sung</a>}else if(issue.WorkerId.HasValue){<a asp-controller="Workers" asp-action="Edit" asp-route-id="@issue.WorkerId">Hồ sơ công nhân</a>}@if(!issue.Advance && issue.Date.HasValue){<a asp-controller="Attendance" asp-action="Index" asp-route-date="@issue.Date.Value.ToString("yyyy-MM-dd")">Sửa chấm công @issue.Date.Value.ToString("dd/MM")</a>}else if(!issue.Advance && !issue.WorkerId.HasValue){<a asp-controller="Attendance" asp-action="Index" asp-route-missingDate="true">Bản ghi thiếu ngày</a>}</span></li>}</ul>@if(Model.Issues.Count>50){<p class="form-text">Hiển thị 50 / @Model.Issues.Count vấn đề.</p>}</div></section>}
<section class="stat-grid payroll-stats"><div class="stat-card"><div class="stat-top">Công nhân trong bảng</div><strong>@Model.Rows.Count<span>người</span></strong><small>Bao gồm người đã nghỉ nhưng có chấm công</small></div><div class="stat-card"><div class="stat-top">Tổng ngày công hợp lệ</div><strong>@Model.Rows.Where(r=>r.NetAmount.HasValue).Sum(r=>r.WorkDays).ToString("0.#",vi)<span>công</span></strong><small>Nửa ngày được quy đổi thành 0,5 công</small></div><div class="stat-card"><div class="stat-top">Giờ lẻ hợp lệ</div><strong>@Model.Rows.Where(r=>r.NetAmount.HasValue).Sum(r=>r.OddHours).ToString("0.#",vi)<span>giờ</span></strong><small>Tính theo mức lương ngày chia 8</small></div><div class="stat-card"><div class="stat-top">@(saved ? "Tổng thực lĩnh đã lưu" : "Tổng thực lĩnh hợp lệ")</div><strong class="payroll-total" data-payroll-total>@(bad ? "Cần kiểm tra" : Model.NetTotal.ToString("N0",vi))<span>đ</span></strong><small>@(saved ? "Giữ nguyên mức lương tại lần chốt" : Model.ValidWorkerCount + " / " + Model.Rows.Count + " công nhân tính được lương")</small></div></section>
<section class="card" data-list data-page-size="15"><div class="list-toolbar"><div class="search-field"><svg class="icon"><use href="#i-search" /></svg><input type="search" class="form-control" data-list-search placeholder="Tìm tên hoặc mã công nhân…" aria-label="Tìm trong bảng lương" /></div><span class="result-count">Tháng @Model.Month.ToString("00")/@Model.Year · VND</span></div>
@if(!Model.Rows.Any()){<div class="empty-state"><svg class="icon empty-icon"><use href="#i-calendar" /></svg><h3>Chưa có dữ liệu tính lương cho tháng này</h3><p>Công nhân không có chấm công trong tháng không được đưa vào bảng lương.</p><a asp-controller="Attendance" asp-action="Calendar" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-farm">Mở chấm công tháng</a></div>}
else{<div class="table-responsive"><table class="table payroll-table"><thead><tr><th>Công nhân</th><th class="text-end">Lương ngày</th><th class="text-end">Ngày đủ công</th><th class="text-end">Nửa ngày</th><th class="text-end">Tổng công</th><th class="text-end">Giờ lẻ</th><th class="text-end">Lương gộp</th><th class="text-end">Tạm ứng</th><th class="text-end">Thực lĩnh</th><th>Chi tiết</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr data-list-row data-search="@row.Code @row.Name"><td><strong>@(row.Name ?? "Chưa có tên")</strong><small class="d-block text-muted">@(row.Code ?? "Chưa có mã")</small></td><td class="text-end">@(row.DailySalary?.ToString("N0",vi) ?? "—")</td><td class="text-end">@row.FullDays</td><td class="text-end">@row.HalfDays</td><td class="text-end">@row.WorkDays.ToString("0.#",vi)</td><td class="text-end">@row.OddHours.ToString("0.#",vi)</td><td class="text-end">@if(row.Amount.HasValue){<strong class="text-success">@row.Amount.Value.ToString("N0",vi) đ</strong>}else{<span class="badge bg-danger">Chưa tính được</span>}</td><td class="text-end">@(row.AdvanceAmount?.ToString("N0",vi)??"Cần kiểm tra") đ</td><td class="text-end"><strong class="text-success">@(row.NetAmount?.ToString("N0",vi)??"Chưa tính được") đ</strong></td><td><details class="payroll-breakdown"><summary>@row.AttendanceCount ngày · @row.Advances.Count phiếu ứng</summary><div>@if(row.Errors.Any()){<ul>@foreach(var error in row.Errors){<li>@error</li>}</ul>}else{<p>@row.WorkDays.ToString("0.#",vi) công × @row.DailySalary?.ToString("N0",vi) đ + @row.OddHours.ToString("0.#",vi) giờ × (lương ngày ÷ 8).</p>}<table class="table table-sm"><thead><tr><th>Ngày</th><th>Giờ làm</th><th>Quy đổi</th></tr></thead><tbody>@foreach(var day in row.Days){<tr><td>@day.Date.ToString("dd/MM")</td><td>@day.Hours.ToString("0.#",vi)</td><td>@(day.Hours>=8 ? "1 công" : day.Hours==4 ? "0,5 công" : day.Hours.ToString("0.#",vi)+" giờ lẻ")</td></tr>}</tbody></table>@if(row.Advances.Any()){<h3 class="h6 mt-3">Phiếu khấu trừ trong tháng</h3><ul>@foreach(var advance in row.Advances){<li>@advance.Reference · @advance.PaidDate.ToString("dd/MM/yyyy"): @advance.Amount.ToString("N0",vi) đ</li>}</ul>}</div></details></td></tr>}</tbody><tfoot><tr><th colspan="8">@(saved ? "Tổng lương đã lưu" : "Tổng các dòng hợp lệ")</th><th class="text-end">@(bad ? "Cần kiểm tra" : Model.NetTotal.ToString("N0",vi)+" đ")</th><th></th></tr></tfoot></table></div><div class="filter-empty" data-list-empty hidden>Không tìm thấy công nhân phù hợp.</div><div class="list-footer"><span data-list-count></span><div class="list-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" data-list-prev>← Trước</button><span data-list-page></span><button type="button" class="btn btn-sm btn-outline-secondary" data-list-next>Sau →</button></div></div>}
</section>
<div class="inline-notice neutral payroll-rule">Công thức: (ngày đủ công + 0,5 × nửa ngày) × lương ngày + giờ lẻ × lương ngày ÷ 8. Làm tròn tổng tiền mỗi người đến 1 đồng, phần 0,5 làm tròn lên. Theo quy tắc chấm công hiện tại, từ 8 giờ trở lên vẫn tính 1 công. Thực lĩnh = lương gộp − tổng tạm ứng thuộc tháng. Không tự chuyển nợ nếu ứng vượt lương.</div>
@if(Model.History.Any()){<section class="card mt-4"><div class="card-header"><h2 class="mb-0">Lịch sử chốt tháng</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Lần chốt</th><th>Thời điểm</th><th>Trạng thái</th><th class="text-end">Tổng tiền lưu</th><th></th></tr></thead><tbody>@foreach(var run in Model.History){<tr><td>#@run.Id</td><td>@(run.FinalizedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Thiếu thời điểm")</td><td><span class="badge @(run.Status==PayrollService.Finalized ? "bg-success":"bg-secondary")">@(run.Status==PayrollService.Finalized ? "Đã chốt" : run.Status==PayrollService.Reopened ? "Đã mở lại" : "Cần kiểm tra")</span>@if(run.ReopenedAt.HasValue){<small class="d-block text-muted">Mở lại @run.ReopenedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>}</td><td class="text-end">@((run.CalculationVersion==1?run.TotalAmount:run.NetTotal)?.ToString("N0",vi) ?? "—") đ</td><td><a asp-action="Archive" asp-route-id="@run.Id" class="text-link">Xem bản lưu →</a></td></tr>}</tbody></table></div></section>}
@section Scripts{<script>document.querySelector('[data-print-payroll]')?.addEventListener('click',()=>window.print());</script>}

@model Farm_Management.Models.PayrollRun
@{ ViewData["Title"]="Mở lại bảng lương"; }
<section class="card form-container-center"><div class="card-body"><p class="eyebrow">ĐIỀU CHỈNH BẢNG LƯƠNG</p><h1>Mở lại tháng @Model.Month?.ToString("00")/@Model.Year?</h1><p class="page-description mb-4">Bạn sẽ có thể sửa chấm công, tạm ứng và tính lại lương của tháng này.</p><div class="inline-notice">Bản chốt #@Model.Id vẫn được lưu trong lịch sử. Bảng tạm tính mới sẽ dùng mức lương ngày hiện tại; cần kiểm tra và chốt lại sau khi hoàn tất điều chỉnh.</div></div><form asp-action="Reopen" method="post" class="form-actions" data-save-form><input type="hidden" name="id" value="@Model.Id" /><a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Giữ nguyên</a><button type="submit" class="btn btn-farm" disabled="@(Model.Status!=Farm_Management.Services.PayrollService.Finalized)">Xác nhận mở lại</button></form></section>

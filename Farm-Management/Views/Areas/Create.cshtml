@model Farm_Management.Models.ViewModels.AreaForm
@{
    ViewData["Title"] = "Thêm vùng trồng"; ViewData["LoadMap"] = true;
    if (!string.IsNullOrWhiteSpace(Model.GpsCoordinates)) {
        var parts = Model.GpsCoordinates.Split(',');
        if(parts.Length == 2 && double.TryParse(parts[0], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat) && double.TryParse(parts[1], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng) && double.IsFinite(lat) && double.IsFinite(lng) && Math.Abs(lat) <= 90 && Math.Abs(lng) <= 180) { ViewData["Latitude"] = lat.ToString(System.Globalization.CultureInfo.InvariantCulture); ViewData["Longitude"] = lng.ToString(System.Globalization.CultureInfo.InvariantCulture); }
    }
}
<div class="page-header"><div><p class="eyebrow">CƠ SỞ TRANG TRẠI</p><h1>Thêm vùng trồng</h1><p class="page-description">Lưu thông tin vùng đất và đánh dấu vị trí canh tác trên bản đồ.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách vùng trồng</a></div>
<div class="form-layout"><form asp-action="Create" class="card form-main" data-save-form><div class="px-4 pt-4"><div asp-validation-summary="ModelOnly"></div></div><input type="hidden" asp-for="Id" /><partial name="_Fields" model="Model" /><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm"><svg class="icon"><use href="#i-check" /></svg>Lưu vùng trồng</button></div></form><aside class="form-aside"><svg class="icon mb-3"><use href="#i-leaf" /></svg><h3>Bắt đầu từ thông tin cơ bản.</h3><p>Chỉ tên vùng trồng là bắt buộc. Bạn có thể cập nhật diện tích, vị trí và kết quả xét nghiệm khi có thông tin.</p><ul><li>Diện tích sử dụng đơn vị mét vuông (m²).</li><li>Bấm bản đồ hoặc kéo điểm đánh dấu để chọn vị trí.</li><li>Thông tin chưa biết có thể để trống.</li></ul></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

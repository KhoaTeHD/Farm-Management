@model Farm_Management.Models.Area
@{ ViewData["Title"] = "Xóa vùng trồng"; }
<partial name="_DeletePanel" model='new Farm_Management.Models.ViewModels.DeleteConfirmationViewModel { Id = Model.Id, Title = "Xóa vùng trồng này?", Description = "Thông tin vùng đất sẽ bị xóa khỏi danh sách vùng trồng.", Notice = "Vùng đang có lô cây sẽ không được phép xóa để giữ lại dữ liệu canh tác.", Items = new() { ("Tên vùng", Model.Name ?? "Chưa có tên"), ("Diện tích", (Model.Acreage?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "—") + " m²"), ("Loại đất", Model.SoilType ?? "Chưa cập nhật"), ("Tọa độ", Model.GpsCoordinates ?? "Chưa cập nhật") } }' />

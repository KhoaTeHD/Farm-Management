@model Farm_Management.Models.ViewModels.AreaForm
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-map" /></svg>Thông tin vùng trồng</h2><div class="row g-3"><div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="VD: Vùng A – Rau ăn lá" /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Acreage" class="form-label"></label><div class="input-group"><input asp-for="Acreage" class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="1000" /><span class="input-group-text">m²</span></div><span asp-validation-for="Acreage"></span></div><div class="col-md-6"><label asp-for="SoilType" class="form-label"></label><input asp-for="SoilType" class="form-control" list="soil-types" placeholder="Chọn hoặc nhập loại đất" /><datalist id="soil-types"><option>Đất phù sa</option><option>Đất thịt</option><option>Đất cát pha</option><option>Đất sét</option><option>Đất đỏ bazan</option></datalist><span asp-validation-for="SoilType"></span></div></div></div>
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-map" /></svg>Vị trí canh tác</h2><partial name="_MapPickerPartial" /><label asp-for="GpsCoordinates" class="form-label"></label><input asp-for="GpsCoordinates" class="form-control" placeholder="VD: 10.762622, 106.660172" id="GpsCoordinates" /><span asp-validation-for="GpsCoordinates"></span><p class="form-text">Chọn điểm trên bản đồ hoặc nhập vĩ độ, kinh độ. Có thể bổ sung sau.</p></div>
<div class="form-section"><h2 class="form-section-title"><svg class="icon"><use href="#i-leaf" /></svg>Chất lượng đất & ghi chú</h2><div class="row g-3"><div class="col-md-5"><label asp-for="SoilTestDate" class="form-label"></label><input asp-for="SoilTestDate" class="form-control" type="date" /><span asp-validation-for="SoilTestDate"></span></div><div class="col-md-7"><label asp-for="SoilTestResult" class="form-label"></label><textarea asp-for="SoilTestResult" class="form-control" rows="2" placeholder="Kết quả kiểm tra, chỉ số pH…"></textarea><span asp-validation-for="SoilTestResult"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="Thông tin cần lưu ý cho vùng trồng này…"></textarea><span asp-validation-for="Notes"></span></div></div></div>

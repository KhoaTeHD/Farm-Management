@model Farm_Management.Models.Area
@{
    ViewData["Title"] = "Chi tiết vùng trồng";
    var mapValid = false; double lat=0, lng=0;
    var parts = Model.GpsCoordinates?.Split(',');
    if(parts?.Length == 2) mapValid = double.TryParse(parts[0],System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out lat) && double.TryParse(parts[1],System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out lng) && double.IsFinite(lat) && double.IsFinite(lng) && Math.Abs(lat)<=90 && Math.Abs(lng)<=180;
    ViewData["LoadMap"] = mapValid;
}
<div class="page-header"><div><p class="eyebrow">CƠ SỞ TRANG TRẠI</p><h1>@(Model.Name ?? "Vùng trồng chưa có tên")</h1><p class="page-description">Thông tin đất, vị trí và các lô cây thuộc vùng canh tác này.</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">← Danh sách</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-farm"><svg class="icon"><use href="#i-edit" /></svg>Sửa thông tin</a></div></div>
<div class="dashboard-grid"><div class="card"><div class="card-header">Hồ sơ vùng trồng</div><div class="card-body"><dl class="definition-grid"><div><dt>Diện tích</dt><dd>@(Model.Acreage?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "—") m²</dd></div><div><dt>Loại đất</dt><dd>@(Model.SoilType ?? "Chưa cập nhật")</dd></div><div><dt>Ngày xét nghiệm</dt><dd>@(Model.SoilTestDate?.ToString("dd/MM/yyyy") ?? "Chưa xét nghiệm")</dd></div><div><dt>Kết quả xét nghiệm</dt><dd>@(Model.SoilTestResult ?? "Chưa cập nhật")</dd></div><div><dt>Tọa độ GPS</dt><dd>@(Model.GpsCoordinates ?? "Chưa đánh dấu vị trí")</dd></div><div><dt>Ghi chú</dt><dd>@(Model.Notes ?? "—")</dd></div></dl></div></div><div class="card"><div class="card-header">Vị trí canh tác</div>@if(mapValid){<div id="area-detail-map" class="detail-map" data-lat="@lat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lng="@lng.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-name="@Model.Name"></div>}else{<div class="empty-state compact"><svg class="icon empty-icon"><use href="#i-map" /></svg><h3>Chưa có vị trí hợp lệ</h3><p>Cập nhật tọa độ để xem vùng canh tác trên bản đồ.</p><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-farm">Cập nhật vị trí</a></div>}</div></div>
<div class="card"><div class="card-header">Lô cây thuộc vùng <span class="pill ms-2">@Model.Plants.Count lô</span></div>@if(Model.Plants.Any()){<div class="table-responsive"><table class="table"><thead><tr><th>Mã lô</th><th>Trạng thái</th><th>Ngày trồng</th></tr></thead><tbody>@foreach(var plant in Model.Plants){<tr><td><a asp-controller="Plants" asp-action="Details" asp-route-id="@plant.Id">@(plant.BatchCode ?? "Chưa có mã")</a></td><td>@(plant.Status == "Growing" ? "Đang trồng" : plant.Status == "Harvested" ? "Đã thu hoạch" : plant.Status == "ReadyToHarvest" ? "Sẵn sàng thu hoạch" : plant.Status == "Destroyed" ? "Đã hủy" : plant.Status ?? "Chưa có trạng thái")</td><td>@(plant.PlantingDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td></tr>}</tbody></table></div>}else{<div class="empty-state compact"><h3>Chưa có lô cây trong vùng này</h3><p>Thông tin lô cây sẽ xuất hiện tại đây khi được ghi nhận.</p></div>}</div>
@section Scripts { @if(mapValid){<script>document.addEventListener('DOMContentLoaded',function(){const el=document.getElementById('area-detail-map');if(!window.L){el.textContent='Chưa tải được bản đồ. Tọa độ vẫn được lưu trong hồ sơ.';return;}const point=[Number(el.dataset.lat),Number(el.dataset.lng)];const map=L.map(el).setView(point,15);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap',maxZoom:19}).addTo(map);L.marker(point).addTo(map).bindPopup(document.createTextNode(el.dataset.name||'Vùng trồng'));});</script>} }

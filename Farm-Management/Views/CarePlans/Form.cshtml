@model Farm_Management.Models.ViewModels.CareStepForm
@{ViewData["Title"]="Việc chăm sóc dự kiến";var p=ViewBag.Plant as Farm_Management.Models.Plant;}
<div class="page-header"><div><p class="eyebrow">KẾ HOẠCH · @(p?.SeasonName??p?.BatchCode)</p><h1>Việc chăm sóc dự kiến</h1><p class="page-description">Viết việc sẽ làm và điều muốn kiểm tra. Chưa phải ghi nhận đã thực hiện.</p></div><a asp-controller="Plants" asp-action="Details" asp-route-id="@Model.PlantId" class="btn btn-outline-secondary">← Về sổ mùa vụ</a></div>
<form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" class="card" data-save-form><input asp-for="Id" type="hidden"/><input asp-for="PlantId" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="Ví dụ: Kiểm tra tỷ lệ cây sống"/><div class="row g-3 mt-2"><div class="col-md-6"><label asp-for="Kind" class="form-label"></label><select asp-for="Kind" class="form-select">@foreach(var k in Farm_Management.Services.CropSeasonRules.Kinds){<option value="@k.Key">@k.Value</option>}</select></div><div class="col-md-6"><label asp-for="PlannedDay" class="form-label"></label><input asp-for="PlannedDay" type="number" min="0" max="36500" class="form-control"/><p class="form-text">Ngày trồng là ngày 0. Ghi 7 nghĩa là một tuần sau ngày trồng.</p></div></div><label asp-for="Instructions" class="form-label"></label><textarea asp-for="Instructions" rows="4" class="form-control" placeholder="Ví dụ: Đếm cây sống ở 3 hàng đại diện, ghi cây héo/vàng lá và chụp ảnh."></textarea><p class="form-text">Dựa trên kinh nghiệm và hướng dẫn phù hợp với cây của bạn. Phần mềm không tự kê lượng phân hoặc thuốc.</p></div><partial name="_RecordChange"/><div class="form-actions"><a asp-controller="Plants" asp-action="Details" asp-route-id="@Model.PlantId" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-farm" type="submit">Lưu việc dự kiến</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

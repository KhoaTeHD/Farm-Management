@model Farm_Management.Models.CropCareStep
@{ViewData["Title"]="Bỏ việc dự kiến";}
<div class="page-header"><h1>Bỏ việc dự kiến?</h1></div><div class="card p-4"><h2>@Model.Title</h2><p>Chỉ bỏ được việc chưa có nhật ký liên kết, để giữ căn cứ đối chiếu kế hoạch với thực tế.</p><form method="post" asp-action="Delete" asp-route-id="@Model.Id"><div class="crop-actions"><partial name="_RecordChange"/><button class="btn btn-danger" type="submit">Bỏ việc này</button><a asp-controller="Plants" asp-action="Details" asp-route-id="@Model.PlantId">Quay về sổ</a></div></form></div>

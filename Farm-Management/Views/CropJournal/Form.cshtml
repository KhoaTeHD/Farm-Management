@model Farm_Management.Models.ViewModels.CropJournalForm
@using Farm_Management.Services
@{ViewData["Title"]=Model.Id==0?"Ghi việc đã làm":"Sửa ghi chép";var plant=ViewBag.Plant as Farm_Management.Models.Plant;var steps=(List<Farm_Management.Models.CropCareStep>)ViewBag.Steps;}
<div class="page-header"><div><p class="eyebrow">SỔ CHĂM SÓC · @(plant?.SeasonName??plant?.BatchCode??"Chọn lại mùa vụ")</p><h1>@ViewData["Title"]</h1><p class="page-description">Ghi việc thực tế đã xảy ra. Một lần chăm hoặc thăm vườn là một ghi chép mới.</p></div><a class="btn btn-outline-secondary" asp-controller="Plants" asp-action="Details" asp-route-id="@Model.PlantId">← Về sổ mùa vụ</a></div>
<div class="form-layout"><form class="card" method="post" enctype="multipart/form-data" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" data-save-form><input asp-for="Id" type="hidden"/><input asp-for="PlantId" type="hidden"/><input asp-for="RecordCode" type="hidden"/><div class="form-section"><div asp-validation-summary="All"></div><h2 class="form-section-title">1. Hôm đó đã làm gì?</h2><label for="journal-kind" class="form-label">Việc đã làm</label><select asp-for="Kind" class="form-select" id="journal-kind">@foreach(var k in CropSeasonRules.Kinds){<option value="@k.Key">@k.Value</option>}</select><div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-6"><label asp-for="Recorder" class="form-label"></label><input asp-for="Recorder" class="form-control" placeholder="Ví dụ: bác Ba"/></div><div class="col-12"><label class="form-label" for="CareStepId">Làm theo việc nào trong kế hoạch? (có thể bỏ trống)</label><select asp-for="CareStepId" class="form-select"><option value="">Việc phát sinh, không chọn kế hoạch</option>@foreach(var s in steps){<option value="@s.Id" data-kind="@s.Kind">Ngày @s.PlannedDay · @s.Title</option>}</select></div></div></div>
<div class="form-section" data-journal-kinds="Water Fertilize Pesticide Harvest"><h2 class="form-section-title">2. Dùng bao nhiêu / thu được bao nhiêu?</h2><div data-journal-kinds="Water"><label asp-for="WaterResourceId" class="form-label"></label><select asp-for="WaterResourceId" class="form-select"><option value="">Chọn nguồn nước của vùng này</option>@foreach(var source in (List<Farm_Management.Models.FieldResource>)ViewBag.WaterSources){<option value="@source.Id">@source.Name · @FarmRecordRules.Statuses.GetValueOrDefault(source.Status??"","Chưa rõ")</option>}</select></div><div data-journal-kinds="Fertilize Pesticide"><label asp-for="InputLotId" class="form-label"></label><select asp-for="InputLotId" class="form-select"><option value="">Chọn lô vật tư đã nhập</option>@foreach(var lot in (List<Farm_Management.Models.InputLot>)ViewBag.Inputs){<option value="@lot.Id" data-kind="@(lot.Kind=="Fertilizer"?"Fertilize":lot.Kind)" data-product="@lot.ProductName">@lot.Code · @lot.ProductName · @FarmRecordRules.Statuses.GetValueOrDefault(lot.Status??"","Chưa rõ")</option>}</select><p class="form-text">Chưa có lô hoặc nguồn? <a asp-controller="FarmRecords" asp-action="Index" target="_blank">Mở Vật tư & kiểm nghiệm</a>, nhập hồ sơ rồi tải lại form này.</p><label asp-for="Material" class="form-label"></label><input asp-for="Material" class="form-control" placeholder="Chép đúng tên trên bao bì"/></div><div class="row g-3 mt-1"><div class="col-md-7"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" min="0.01" max="1000000000" step="0.01"/><p class="form-text">Ghi tổng lượng của lần này cho cả lô. Ví dụ: 200 lít nước hoặc 2 kg phân. Khi thu hoạch chỉ nhập kg.</p></div><div class="col-md-5"><label asp-for="Unit" class="form-label"></label><select asp-for="Unit" class="form-select"><option value="">Chọn đơn vị</option><option value="l" data-kinds="Water Fertilize Pesticide">lít</option><option value="m3" data-kinds="Water">m³</option><option value="kg" data-kinds="Fertilize Pesticide Harvest">kg</option><option value="g" data-kinds="Fertilize Pesticide">g</option><option value="ml" data-kinds="Fertilize Pesticide">ml</option></select></div></div><div class="mt-3" data-journal-kinds="Pesticide"><label asp-for="WithdrawalDays" class="form-label"></label><input asp-for="WithdrawalDays" type="number" min="0" max="36500" class="form-control"/><p class="form-text">Đọc số ngày cách ly trên nhãn đúng sản phẩm và cây trồng. Không biết thì hỏi người phụ trách trước khi lưu; không tự nhập 0.</p></div><div class="mt-3" data-journal-kinds="Harvest"><label asp-for="Quality" class="form-label"></label><input asp-for="Quality" class="form-control" placeholder="Ví dụ: loại A, quả đều / có quả bị dập"/></div></div>
<div class="form-section" data-journal-kinds="Observation"><h2 class="form-section-title">2. Cây hiện giờ thế nào?</h2><div class="row g-3"><div class="col-md-6"><label asp-for="GrowthStage" class="form-label"></label><select asp-for="GrowthStage" class="form-select"><option value="">Chọn giai đoạn</option>@foreach(var s in CropSeasonRules.Stages){<option value="@s.Key">@s.Value</option>}</select></div><div class="col-md-6"><label asp-for="Condition" class="form-label"></label><select asp-for="Condition" class="form-select"><option value="">Chọn tình trạng</option>@foreach(var c in CropSeasonRules.Conditions){<option value="@c.Key">@c.Value</option>}</select></div><div class="col-md-4"><label asp-for="HeightCm" class="form-label"></label><input asp-for="HeightCm" type="number" min="0" max="100000" step="0.01" class="form-control"/></div><div class="col-md-4"><label asp-for="SurvivalPercent" class="form-label"></label><input asp-for="SurvivalPercent" type="number" min="0" max="100" step="0.01" class="form-control"/></div><div class="col-md-4"><label asp-for="AffectedPercent" class="form-label"></label><input asp-for="AffectedPercent" type="number" min="0" max="100" step="0.01" class="form-control"/></div></div><p class="form-text">Số đo không bắt buộc: chưa đo thì để trống. Ví dụ kiểm tra 100 cây, còn sống 95 cây thì ghi 95%. Ghi cùng cách đo ở các lần để dễ so sánh.</p></div>
<div class="form-section"><h2 class="form-section-title">3. Cách làm và điều quan sát được</h2><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" rows="4" class="form-control" placeholder="Ví dụ: Tưới sáng sớm, đất đủ ẩm. Hàng cuối hơi héo, sẽ kiểm tra ngày mai."></textarea><div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="Method" class="form-label"></label><input asp-for="Method" class="form-control" placeholder="Ví dụ: tưới gốc / bón quanh gốc"/></div><div class="col-md-6"><label asp-for="Weather" class="form-label"></label><input asp-for="Weather" class="form-control" placeholder="Ví dụ: nắng, đất khô / mưa nhiều"/></div></div><label asp-for="Photo" class="form-label mt-3"></label><input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control"/><p class="form-text">Không bắt buộc. JPG, PNG hoặc WebP tối đa 5 MB. Nên chụp cùng vị trí qua các lần.</p>@if(CropSeasonRules.PhotoIsLocal(Model.ExistingPhoto)){<img src="@Model.ExistingPhoto" alt="Ảnh ghi chép hiện tại" class="crop-photo"/><label class="d-block mt-2"><input asp-for="RemovePhoto"/> Bỏ ảnh khỏi ghi chép</label>}</div><partial name="_RecordChange"/><div class="form-actions"><a asp-controller="Plants" asp-action="Details" asp-route-id="@Model.PlantId" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-farm">Lưu vào sổ mùa vụ</button></div></form><aside class="form-aside"><h3>Ghi đúng việc, thấy rõ thay đổi</h3><ol><li>Chọn việc và ngày đã làm.</li><li>Ghi lượng thực tế, không ghi lượng dự định.</li><li>Thấy cây vàng lá, sâu, héo… ghi rõ mô tả.</li><li>Bấm Lưu rồi xem lại trong sổ. Nhập sai thì chọn Sửa ghi chép.</li></ol><p>Cần ghi việc sẽ làm? Quay về sổ, chọn “Thêm việc dự kiến”. Kế hoạch và nhật ký là hai phần riêng.</p></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/crop-journal.js" asp-append-version="true"></script>}

@model Farm_Management.Models.HarvestTrace
@{ViewData["Title"]="Cập nhật bản truy xuất";}
<div class="page-header"><h1>Cập nhật bản lưu của mã @Model.Code?</h1></div><form method="post" asp-action="Reissue" asp-route-id="@Model.Id" class="card"><div class="form-section"><p>Đối chiếu sổ mùa vụ, vật tư, nguồn nước và phiếu trước khi xác nhận. Mã lô giữ nguyên; nội dung bản trước được giữ trong lịch sử để xem lại.</p></div><partial name="_RecordChange"/><div class="form-actions"><a asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button type="submit" class="btn btn-farm">Lưu bản truy xuất mới</button></div></form>

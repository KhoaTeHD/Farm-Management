@model Farm_Management.Models.HarvestTrace
@using Farm_Management.Services
@{ViewData["Title"]="Hồ sơ truy xuất thu hoạch";var s=ViewBag.Snapshot as TraceSnapshot;var historical=ViewBag.Historical as bool?==true;var reports=ViewBag.Tests as List<Farm_Management.Models.InspectionReport>??new();}
<div class="page-header"><div><p class="eyebrow">BẢN HỒ SƠ TRUY XUẤT ĐÃ LƯU</p><h1>@(Model.Code??"Hồ sơ thiếu mã")</h1><p class="page-description">Mã nhận diện một đợt thu hoạch; không phải mã chứng nhận VietGAP hoặc kết luận sản phẩm an toàn.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Tra cứu lô khác</a></div>
<div class="crop-actions mb-4"><button type="button" class="btn btn-outline-farm" onclick="window.print()">In hồ sơ</button><a asp-controller="RecordHistory" asp-action="Index" asp-route-recordType="HarvestTrace" asp-route-recordId="@Model.Id">Lịch sử các bản truy xuất</a>@if(!historical){<a asp-action="Reissue" asp-route-id="@Model.Id">Cập nhật bản lưu sau đối chiếu</a><a asp-controller="FarmRecords" asp-action="CreateInspection" asp-route-targetType="HarvestTrace" asp-route-targetId="@Model.Id">Thêm phiếu kiểm nghiệm sản phẩm</a>}</div>
@if(historical){<div class="alert alert-info">Đang xem phiên bản lịch sử, phản ánh thông tin tại lần lưu đó.</div>}
@if(ViewBag.CodeConflict==true){<div class="alert alert-danger">Mã thu hoạch thiếu hoặc bị trùng trong dữ liệu hiện tại. Cần kiểm tra hồ sơ trước khi dùng mã này để truy xuất.</div>}
@if(Model.IsVoided!=false){<div class="alert alert-danger">Mã này đã ngừng dùng hoặc thiếu trạng thái. Không dùng làm hồ sơ lô đang lưu hành; xem lịch sử để biết lý do.</div>}
@if(ViewBag.SourceChanged==true){<div class="alert alert-warning">Hồ sơ nguồn hiện tại đã thay đổi so với bản lưu. Bản dưới đây được giữ nguyên; cần đối chiếu và cập nhật có lý do trước khi sử dụng bản mới.</div>}
@if(s==null){<div class="alert alert-danger">Bản lưu bị thiếu hoặc không khớp dữ liệu. Chưa thể xác nhận nội dung truy xuất.</div>}else{
<section class="card mb-4"><div class="card-header"><h2>Nguồn gốc và đợt thu hoạch</h2></div><div class="card-body"><dl class="definition-grid"><div><dt>Mùa vụ / mã lô trồng</dt><dd>@(s.Season??"Chưa có tên") · @s.LotCode</dd></div><div><dt>Vùng / loại cây</dt><dd>@(s.Area??"Chưa có") · @(s.Crop??"Chưa có")</dd></div><div><dt>Giống / nơi cung cấp</dt><dd>@(s.Seed??"Chưa có") · @(s.SeedOrigin??"Chưa có")</dd></div><div><dt>Ngày trồng</dt><dd>@s.PlantingDate?.ToString("dd/MM/yyyy")</dd></div><div><dt>Ngày thu hoạch / lượng</dt><dd>@s.HarvestDate.ToString("dd/MM/yyyy") · @s.WeightKg.ToString("0.##") kg</dd></div><div><dt>Chất lượng ghi nhận</dt><dd>@s.Quality</dd></div></dl><p class="form-text">Hồ sơ được giữ ít nhất đến @s.HarvestDate.AddMonths(24).ToString("dd/MM/yyyy"); ứng dụng hiện giữ toàn bộ, không tự xóa.</p><a asp-controller="Plants" asp-action="Details" asp-route-id="@s.PlantId">Mở sổ mùa vụ hiện tại →</a></div></section>
@if(s.Warnings.Any()){<div class="alert alert-warning"><strong>Những điểm cần đối chiếu</strong><ul>@foreach(var warning in s.Warnings){<li>@warning</li>}</ul></div>}
<partial name="_MaterialUsage" model="new Farm_Management.Models.ViewModels.MaterialUsageTableViewModel { Rows = MaterialUsageService.FromJournal(s.Journal).Concat(s.LegacyMaterialUses ?? new()).ToList(), IsSnapshot = true, OlderLegacySnapshot = s.LegacyMaterialUses == null && s.LegacyNotes.Any() }"/>
<section class="card mb-4"><div class="card-header"><h2>Quá trình chăm sóc trong bản lưu</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Ngày / công việc</th><th>Nội dung / người thực hiện</th><th>Lô vật tư / nguồn nước</th></tr></thead><tbody>@foreach(var e in s.Journal){<tr><td>@e.Date?.ToString("dd/MM/yyyy") · @CropSeasonRules.KindLabel(e.Kind)</td><td><p class="preserve-lines">@e.Summary</p><small>@e.Recorder · @e.Amount @e.Unit · @e.Method</small>@if(CropSeasonRules.PhotoIsLocal(e.PhotoPath)){<a href="@e.PhotoPath" target="_blank" rel="noopener">Ảnh đã lưu</a>}</td><td>@(e.InputLotId.HasValue?s.Inputs.FirstOrDefault(l=>l.Id==e.InputLotId)?.Code:"—")<small class="d-block">@(e.WaterResourceId.HasValue?s.Resources.FirstOrDefault(r=>r.Id==e.WaterResourceId)?.Name:"—")</small></td></tr>}</tbody></table></div>@if(!s.Journal.Any()){<p class="p-4">Chưa có nhật ký trong sổ mới.</p>}@foreach(var old in s.LegacyNotes){<p class="px-4">Sổ cũ: @old</p>}</section>
<div class="crop-comparison mb-4"><section class="card"><div class="card-header"><h2>Vật tư và nguồn gốc đã lưu</h2></div><div class="card-body">@foreach(var l in s.Inputs){<p><strong>@l.Code · @l.ProductName</strong><br/>Lô NSX: @l.ManufacturerBatch · Nơi mua: @l.Supplier<br/>Nhận @l.ReceivedDate?.ToString("dd/MM/yyyy") · Hạn @l.ExpiryDate?.ToString("dd/MM/yyyy") · @l.InvoiceNumber</p>}@if(!s.Inputs.Any()){<p>Chưa gắn được lô vật tư đầu vào.</p>}</div></section><section class="card"><div class="card-header"><h2>Đất và nguồn nước đã lưu</h2></div><div class="card-body">@foreach(var r in s.Resources){<h3 class="h6">@r.Name · @FarmRecordRules.ResourceKinds.GetValueOrDefault(r.Kind??"","Chưa rõ")</h3><p>@r.Location</p><p class="preserve-lines">@r.RiskAssessment · @r.Treatment</p>}@if(!s.Resources.Any()){<p>Chưa có hồ sơ đất/nguồn nước của vùng.</p>}</div></section></div>
<section class="card"><div class="card-header"><h2>Kiểm nghiệm trong bản lưu</h2></div><div class="card-body">@foreach(var r in s.Reports){<h3 class="h6">@r.ReportNumber · @r.Laboratory</h3><p>@r.Indicator · @r.Result · @FarmRecordRules.Conclusions.GetValueOrDefault(r.Conclusion??"","Chưa rõ")</p><p>Đối chiếu: @r.LimitReference</p>@if(FarmRecordRules.EvidenceLocal(r.EvidencePath)){<a href="@r.EvidencePath" target="_blank" rel="noopener">Mở bản phiếu đã lưu</a>}}@if(!s.Reports.Any()){<p>Chưa có phiếu liên kết trong bản này.</p>}</div></section>
}
@if(!historical && reports.Any()){<section class="card mt-4"><div class="card-header"><h2>Phiếu sản phẩm hiện tại, để đối chiếu</h2></div><div class="card-body">@foreach(var r in reports){<p>@r.ReportNumber · @r.Indicator · @FarmRecordRules.Conclusions.GetValueOrDefault(r.Conclusion??"","Chưa rõ")</p>}</div></section>}

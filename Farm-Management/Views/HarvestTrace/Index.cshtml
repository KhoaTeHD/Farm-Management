@model List<Farm_Management.Models.HarvestTrace>
@{ViewData["Title"]="Truy xuất lô thu hoạch";var legacy=(List<Farm_Management.Models.HarvestBatch>)ViewBag.Legacy;}
<div class="page-header"><div><h1>Truy xuất các lô thu hoạch</h1><p class="page-description">Mỗi đợt thu hoạch trong sổ mới có một mã riêng. Bản truy xuất lưu nguồn gốc và quá trình chăm sóc đã ghi.</p></div><a asp-controller="Plants" asp-action="Index" class="btn btn-outline-secondary">Mở các mùa vụ</a></div><form asp-action="Index" method="get" class="card p-4 mb-4"><label for="trace-code" class="form-label">Nhập mã lô thu hoạch để tìm</label><div class="crop-actions"><input id="trace-code" name="code" value="@ViewBag.Code" class="form-control" maxlength="50" placeholder="TH-20261108-…"/><button type="submit" class="btn btn-farm">Tra cứu</button></div></form><section class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Mã thu hoạch</th><th>Ngày / mùa vụ</th><th>Sản lượng</th><th>Trạng thái hồ sơ</th><th></th></tr></thead><tbody>@foreach(var h in Model){<tr><td><a asp-action="Details" asp-route-id="@h.Id">@(h.Code??"Thiếu mã")</a></td><td>@(h.HarvestDate?.ToString("dd/MM/yyyy")??"Chưa có ngày") · Lô #@h.PlantId</td><td>@(h.WeightKg?.ToString("0.##")??"Chưa có") kg</td><td>@(h.IsVoided==false?"Đang dùng":h.IsVoided==true?"Đã ngừng dùng":"Cần kiểm tra")</td><td><a asp-action="Details" asp-route-id="@h.Id">Mở hồ sơ →</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="p-4">Chưa có mã phù hợp. Ghi một đợt Thu hoạch từ hồ sơ mùa vụ để được cấp mã tự động.</p>}</section>
@if(legacy.Any()){<section class="card mt-4"><div class="card-header"><h2>Đợt thu hoạch từ sổ cũ chưa cấp mã mới</h2></div><div class="card-body">@foreach(var h in legacy){<p>@(h.HarvestDate?.ToString("dd/MM/yyyy")??"Thiếu ngày") · @(h.YieldKg?.ToString()??"Thiếu lượng") kg · Lô #@h.PlantId <a asp-action="CreateLegacy" asp-route-id="@h.Id">Kiểm tra và cấp mã</a></p>}</div></section>}
